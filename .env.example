# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to source control.
STORAGELENS_SQL_PASSWORD=ReplaceWithStrongPassword123!
STORAGELENS_AZURE_SQL_CONNECTION_STRING=Server=tcp:<your-server>.database.windows.net,1433;Initial Catalog=StorageLens;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;User ID=<your-user>;Password=<your-password>;
STORAGELENS_SERVICE_API_KEY=replace-with-a-strong-random-key
# Unlocks the Pricing Admin and Client Management pages. Leave empty to keep them locked.
STORAGELENS_OWNER_PIN=
