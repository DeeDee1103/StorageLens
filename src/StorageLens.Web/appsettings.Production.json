{
  "ServiceEndpoints": {
    "Locations": "http://storagelens-locations/",
    "ScanJobs": "http://storagelens-scanjobs/",
    "FileInventory": "http://storagelens-fileinventory/",
    "Duplicates": "http://storagelens-duplicates/",
    "Analytics": "http://storagelens-analytics/",
    "Orchestrator": "http://storagelens-orchestrator/"
  },
  "DatabaseConfig": {
    "Provider": "AzureSql",
    "UseInMemory": false,
    "AzureSqlServer": "",
    "AzureSqlDatabase": "StorageLens",
    "AzureSqlUserId": "",
    "AzureSqlEncrypt": true,
    "AzureSqlTrustServerCertificate": false,
    "ConnectionTimeout": 30,
    "MinPoolSize": 5,
    "MaxPoolSize": 200,
    "ApplicationName": "StorageLens"
  },
  "Appearance": {
    "DefaultTheme": "system",
    "DefaultLandingPage": "/Index",
    "TablePageSize": 25,
    "ScanAutoRefreshSeconds": 10,
    "DashboardDaysRange": 30,
    "EnableKpiCountAnimation": true,
    "SidebarCollapsedByDefault": false
  },
  "Notifications": {
    "EmailEnabled": false,
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUseSsl": true,
    "SmtpUsername": "",
    "FromAddress": "",
    "FromName": "StorageLens",
    "ToAddresses": "",
    "WebhookEnabled": false,
    "WebhookUrl": "",
    "WebhookSecret": "",
    "NotifyOnScanComplete": true,
    "NotifyOnScanFailed": true,
    "NotifyOnDuplicatesFound": false,
    "NotifyOnStorageThreshold": false,
    "StorageThresholdPercent": 90
  },
  "ScannerPerformance": {
    "HashingMaxDegreeOfParallelism": 8,
    "HashingBatchSize": 1000,
    "HashingMaxFileSizeBytes": 4294967296,
    "ScannerEnableAutoMapping": true,
    "ScannerAutoMapInContainerOnly": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
