{
  "DetailedErrors": true,
  "DatabaseConfig": {
    "Provider": "AzureSql",
    "UseInMemory": false,
    "AzureSqlServer": "<your-azure-sql-server>",
    "AzureSqlDatabase": "StorageLens",
    "AzureSqlUserId": "<your-sql-user>",
    "AzureSqlEncrypt": true,
    "AzureSqlTrustServerCertificate": false,
    "ConnectionTimeout": 30,
    "MinPoolSize": 0,
    "MaxPoolSize": 100,
    "ApplicationName": "StorageLens"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
