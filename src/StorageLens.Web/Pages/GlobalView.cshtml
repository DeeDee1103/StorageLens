@page
@model GlobalViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Dashboard";
    ViewData["Nav"] = "dashboard";

    var locationsJson = JsonSerializer.Serialize(Model.Dashboard.Locations.Select(loc => new {
        id = loc.Id,
        name = loc.Name,
        path = loc.Path,
        siteLocation = loc.SiteLocation,
        type = loc.Type,
        status = loc.Status,
        totalSizeBytes = loc.TotalSizeBytes,
        fileCount = loc.FileCount,
        latitude = loc.Latitude,
        longitude = loc.Longitude
    }));
    var growthLabels = JsonSerializer.Serialize(Model.Dashboard.StorageGrowth.Select(x => x.Label));
    var growthValues = JsonSerializer.Serialize(Model.Dashboard.StorageGrowth.Select(x => x.Value));
    var typeLabels = JsonSerializer.Serialize(Model.Dashboard.FileTypeDistribution.Select(x => x.Label));
    var typeValues = JsonSerializer.Serialize(Model.Dashboard.FileTypeDistribution.Select(x => x.Value));

    var totalBytes = Model.Dashboard.Kpis.TotalStorageBytes;
    var totalDisplay = SizeFormatter.ToFriendlySize(totalBytes);

    var locations = Model.Dashboard.Locations;
    var maxBytes = locations.Any() ? locations.Max(l => l.TotalSizeBytes) : 1L;

    var runningJobs = Model.Dashboard.RecentJobs.Where(j =>
        j.Status.Equals("Running", StringComparison.OrdinalIgnoreCase) ||
        j.Status.Equals("Queued", StringComparison.OrdinalIgnoreCase)).Take(3).ToList();
    var totalJobs = Model.Dashboard.RecentJobs.Count;
    var completedJobs = Model.Dashboard.RecentJobs.Count(j =>
        j.Status.Equals("Completed", StringComparison.OrdinalIgnoreCase));
    var avgProgress = totalJobs > 0 ? (int)Model.Dashboard.RecentJobs.Average(j => j.ProgressPercent) : 0;
    var completedPct = totalJobs > 0 ? completedJobs * 100 / totalJobs : 0;
    var jobLoadPct = Math.Min(totalJobs * 10, 100);

    var dupPct = Model.Dashboard.Kpis.DuplicatePercent;
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="gv-shell reveal-item">

    <!-- Header bar -->
    <div class="gv-headbar">
        <div class="gv-brand-pill">
            <span class="sl-logo sl-logo--gv" role="img" aria-label="StorageLens">
                <span class="sl-logo__line sl-logo__line--left"></span>
                <span class="sl-logo__core">
                    <span class="sl-logo__frame"></span>
                    <span class="sl-logo__bar sl-logo__bar--top"></span>
                    <span class="sl-logo__text">ST<span class="sl-logo__o"></span>RAGELENS</span>
                    <span class="sl-logo__bar sl-logo__bar--bottom"></span>
                </span>
                <span class="sl-logo__line sl-logo__line--right"></span>
            </span>
        </div>
        <div class="gv-search-strip">
            <i class="bi bi-search" aria-hidden="true"></i>
            <span>Scan history &amp; locations</span>
        </div>
        <div class="gv-header-actions">
            <a class="gv-action-btn" asp-page="/StorageLocations" title="Manage Locations">
                <i class="bi bi-hdd-stack"></i>
            </a>
            <a class="gv-action-btn" asp-page="/ScanJobs" title="Scan Jobs">
                <i class="bi bi-activity"></i>
            </a>
            <a class="gv-action-btn" asp-page="/Reports" title="Reports">
                <i class="bi bi-bar-chart-fill"></i>
            </a>
        </div>
    </div>

    <!-- Tagline strip -->
    <div class="gv-tagline-strip">
        <div class="gv-tagline-avatar" id="gvAvatar">DD</div>
        <div>
            <div class="gv-tagline-name" id="gvProfileName">StorageLens</div>
            <div class="gv-tagline">Optimize Storage. Gain Visibility.</div>
        </div>
        <div class="gv-tagline-status">
            <span class="gv-status-dot @(Model.ServiceUnavailable ? "gv-status-dot--warn" : "gv-status-dot--ok")"></span>
            @(Model.ServiceUnavailable ? "Service degraded" : "All systems nominal")
        </div>
    </div>

    @if (Model.ServiceUnavailable)
    {
        <div class="gv-alert-bar">
            <i class="bi bi-exclamation-triangle-fill"></i>
            Analytics service unavailable — showing cached or empty data.
        </div>
    }

    <!-- KPI row -->
    <div class="gv-kpi-row">
        <article class="gv-kpi gv-kpi--teal">
            <div class="gv-kpi-label">Total Storage</div>
            <div class="gv-kpi-value">@totalDisplay</div>
            <div class="gv-kpi-trend"><span class="gv-trend-line"></span>Live metric</div>
        </article>
        <article class="gv-kpi gv-kpi--blue">
            <div class="gv-kpi-label">Total Files</div>
            <div class="gv-kpi-value">@Model.Dashboard.Kpis.TotalFiles.ToString("N0")</div>
            <div class="gv-kpi-trend"><span class="gv-trend-line"></span>Live metric</div>
        </article>
        <article class="gv-kpi gv-kpi--lime">
            <div class="gv-kpi-label">Duplicate %</div>
            <div class="gv-kpi-value">@dupPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)<span class="gv-kpi-unit">%</span></div>
            <div class="gv-kpi-trend"><span class="gv-trend-line gv-trend-line--warn"></span>Monitor</div>
        </article>
        <article class="gv-kpi gv-kpi--mint">
            <div class="gv-kpi-label">Potential Savings</div>
            <div class="gv-kpi-value">@SizeFormatter.ToFriendlySize(Model.Dashboard.Kpis.PotentialSavingsBytes)</div>
            <div class="gv-kpi-trend"><span class="gv-trend-line"></span>Actionable</div>
        </article>
        <article class="gv-kpi gv-kpi--purple">
            <div class="gv-kpi-label">Locations</div>
            <div class="gv-kpi-value">@locations.Count</div>
            <div class="gv-kpi-trend"><span class="gv-trend-line"></span>Active sites</div>
        </article>
    </div>

    <!-- Main body grid -->
    <div class="gv-body-grid">

        <!-- Left column: storage tiers sparkline + bar list -->
        <aside class="gv-left-col">
            <section class="gv-panel gv-panel--left-top">
                <div class="gv-panel-title">Storage Tiers</div>
                <div class="gv-panel-subtitle">Capacity trend over time</div>
                <div class="gv-tier-chart-wrap">
                    <canvas id="gvTiersChart"></canvas>
                </div>
                <div class="gv-tier-bars">
                    @foreach (var loc in locations.OrderByDescending(l => l.TotalSizeBytes).Take(8))
                    {
                        var pct = maxBytes > 0 ? (int)((loc.TotalSizeBytes * 100L) / maxBytes) : 0;
                        var barClass = loc.Status.ToLowerInvariant() switch {
                            "online"  => "gv-tier-fill gv-tier-fill--teal",
                            "warning" => "gv-tier-fill gv-tier-fill--warn",
                            _         => "gv-tier-fill gv-tier-fill--off"
                        };
                        <div class="gv-tier-row" title="@loc.Name — @SizeFormatter.ToFriendlySize(loc.TotalSizeBytes)">
                            <div class="gv-tier-label">@loc.Name</div>
                            <div class="gv-tier-track"><div class="@barClass" style="width:@pct%"></div></div>
                            <div class="gv-tier-size">@SizeFormatter.ToFriendlySize(loc.TotalSizeBytes)</div>
                        </div>
                    }
                    @if (!locations.Any())
                    {
                        <div class="gv-empty-hint"><i class="bi bi-inbox"></i> No locations yet</div>
                    }
                </div>
            </section>
        </aside>

        <!-- Centre: world map -->
        <section class="gv-map-col">
            <div class="gv-panel gv-panel--map">
                <div class="gv-panel-header">
                    <div>
                        <div class="gv-panel-title">Global Storage Distribution</div>
                        <div class="gv-panel-subtitle">
                            @locations.Count location@(locations.Count != 1 ? "s" : "") from live analytics
                        </div>
                    </div>
                    <div class="gv-map-legend">
                        <span class="gv-legend-dot gv-legend-dot--online"></span>Online
                        <span class="gv-legend-dot gv-legend-dot--warn"></span>Warning
                        <span class="gv-legend-dot gv-legend-dot--off"></span>Offline
                    </div>
                </div>
                <div id="globalMap" class="gv-map"></div>
            </div>
        </section>

        <!-- Right column: workflows + file-type mix -->
        <aside class="gv-right-col">
            <section class="gv-panel">
                <div class="gv-panel-title">Active Workflows</div>
                <div class="gv-panel-subtitle">Running scan jobs</div>
                <div class="gv-workflow-grid">
                    <div class="gv-wf-stat">
                        <div class="gv-wf-ring">
                            <svg viewBox="0 0 36 36" class="gv-ring-svg">
                                <circle cx="18" cy="18" r="15.9" fill="none" stroke="rgba(62,242,208,0.12)" stroke-width="3"/>
                                <circle cx="18" cy="18" r="15.9" fill="none" stroke="#3ef2d0" stroke-width="3"
                                    stroke-dasharray="@avgProgress 100" stroke-linecap="round"
                                    transform="rotate(-90 18 18)"/>
                            </svg>
                            <div class="gv-ring-label">@avgProgress<span>%</span></div>
                        </div>
                        <div class="gv-wf-name">Avg Progress</div>
                    </div>
                    <div class="gv-wf-stat">
                        <div class="gv-wf-ring">
                            <svg viewBox="0 0 36 36" class="gv-ring-svg">
                                <circle cx="18" cy="18" r="15.9" fill="none" stroke="rgba(107,143,255,0.15)" stroke-width="3"/>
                                <circle cx="18" cy="18" r="15.9" fill="none" stroke="#6b8fff" stroke-width="3"
                                    stroke-dasharray="@completedPct 100" stroke-linecap="round"
                                    transform="rotate(-90 18 18)"/>
                            </svg>
                            <div class="gv-ring-label" style="color:#6b8fff">@completedJobs<span>done</span></div>
                        </div>
                        <div class="gv-wf-name">Completed</div>
                    </div>
                    <div class="gv-wf-stat">
                        <div class="gv-wf-ring">
                            <svg viewBox="0 0 36 36" class="gv-ring-svg">
                                <circle cx="18" cy="18" r="15.9" fill="none" stroke="rgba(167,139,250,0.15)" stroke-width="3"/>
                                <circle cx="18" cy="18" r="15.9" fill="none" stroke="#a78bfa" stroke-width="3"
                                    stroke-dasharray="@jobLoadPct 100" stroke-linecap="round"
                                    transform="rotate(-90 18 18)"/>
                            </svg>
                            <div class="gv-ring-label" style="color:#a78bfa">@totalJobs<span>jobs</span></div>
                        </div>
                        <div class="gv-wf-name">Total Jobs</div>
                    </div>
                </div>
            </section>

            <section class="gv-panel gv-panel--typemix">
                <div class="gv-panel-title">File Type Mix</div>
                <div class="gv-panel-subtitle">By volume</div>
                <div class="gv-type-chart-wrap">
                    <canvas id="gvTypeChart"></canvas>
                </div>
            </section>
        </aside>

    </div>

    <!-- Bottom strip -->
    <div class="gv-bottom-grid">

        <section class="gv-panel gv-panel--gauge">
            <div class="gv-panel-title">Export Monitor</div>
            <div class="gv-panel-subtitle">Duplicate waste ratio</div>
            <div class="gv-gauge-wrap">
                <canvas id="gvExportGauge"></canvas>
                <div class="gv-gauge-label">
                    <div class="gv-gauge-value">@dupPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%</div>
                    <div class="gv-gauge-sub">Duplicates</div>
                </div>
            </div>
            <div class="gv-gauge-stats">
                <div class="gv-gauge-stat">
                    <span class="gv-gauge-stat-lbl">Waste</span>
                    <span class="gv-gauge-stat-val">@SizeFormatter.ToFriendlySize(Model.Dashboard.Kpis.PotentialSavingsBytes)</span>
                </div>
                <div class="gv-gauge-stat">
                    <span class="gv-gauge-stat-lbl">Files</span>
                    <span class="gv-gauge-stat-val">@Model.Dashboard.Kpis.TotalFiles.ToString("N0")</span>
                </div>
            </div>
        </section>

        <section class="gv-panel gv-panel--locations">
            <div class="gv-panel-header">
                <div>
                    <div class="gv-panel-title">Recent Storages</div>
                    <div class="gv-panel-subtitle">Configured locations by size</div>
                </div>
                <a class="gv-see-all" asp-page="/StorageLocations">See all <i class="bi bi-arrow-right"></i></a>
            </div>
            <div class="gv-loc-list">
                @if (!locations.Any())
                {
                    <div class="gv-empty-hint"><i class="bi bi-inbox"></i> No storage locations configured</div>
                }
                @foreach (var loc in locations.OrderByDescending(l => l.TotalSizeBytes).Take(6))
                {
                    var dotClass = loc.Status.ToLowerInvariant() switch {
                        "online"  => "gv-loc-dot--online",
                        "warning" => "gv-loc-dot--warn",
                        _         => "gv-loc-dot--off"
                    };
                    <div class="gv-loc-row" data-loc-id="@loc.Id">
                        <span class="gv-loc-dot @dotClass"></span>
                        <div class="gv-loc-info">
                            <span class="gv-loc-name">@loc.Name</span>
                            <span class="gv-loc-path">@loc.Path</span>
                        </div>
                        <div class="gv-loc-meta">
                            <span class="gv-loc-size">@SizeFormatter.ToFriendlySize(loc.TotalSizeBytes)</span>
                            <span class="gv-loc-files">@loc.FileCount.ToString("N0") files</span>
                        </div>
                        <span class="gv-loc-type">@loc.Type</span>
                    </div>
                }
            </div>
        </section>

    </div>

</div>

@section Scripts {
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
(function () {
    const locations = @Html.Raw(locationsJson);
    const growthLabels = @Html.Raw(growthLabels);
    const growthValues = @Html.Raw(growthValues);
    const typeLabels = @Html.Raw(typeLabels);
    const typeValues = @Html.Raw(typeValues);
    const dupPct = @dupPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    const statusColour = { online: '#3ef2d0', warning: '#f5a623', offline: '#f45b5b', error: '#f45b5b' };

    const fmt = (bytes) => {
        if (!bytes) return '0 B';
        if (bytes >= 1099511627776) return (bytes / 1099511627776).toFixed(1) + ' TB';
        if (bytes >= 1073741824)    return (bytes / 1073741824).toFixed(1) + ' GB';
        if (bytes >= 1048576)       return (bytes / 1048576).toFixed(1) + ' MB';
        return (bytes / 1024).toFixed(1) + ' KB';
    };

    const fmtNum = (n) => (n || 0).toLocaleString();

    const statusDot = (s) => {
        const c = statusColour[(s || '').toLowerCase()] || '#8ea4cb';
        return `<span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:${c};margin-right:5px;vertical-align:middle"></span>`;
    };

    const coordPool = [
        { lat: 37.7749, lng: -122.4194 }, // San Francisco
        { lat: 40.7128, lng: -74.0060 },  // New York
        { lat: 51.5074, lng: -0.1278 },   // London
        { lat: 48.8566, lng: 2.3522 },    // Paris
        { lat: 52.5200, lng: 13.4050 },   // Berlin
        { lat: 35.6762, lng: 139.6503 },  // Tokyo
        { lat: 1.3521, lng: 103.8198 },   // Singapore
        { lat: -33.8688, lng: 151.2093 }, // Sydney
        { lat: 43.6532, lng: -79.3832 },  // Toronto
        { lat: 25.2048, lng: 55.2708 },   // Dubai
        { lat: -23.5505, lng: -46.6333 }, // Sao Paulo
    ];

    const hashValue = (value) => {
        const text = (value || '').toString();
        let hash = 0;
        for (let i = 0; i < text.length; i++) {
            hash = ((hash << 5) - hash) + text.charCodeAt(i);
            hash |= 0;
        }
        return Math.abs(hash);
    };

    const resolveCoordinatesFromSite = (siteLocation) => {
        const text = (siteLocation || '').trim();
        if (!text) {
            return null;
        }

        const numeric = text.match(/^\s*(-?\d+(?:\.\d+)?)\s*,\s*(-?\d+(?:\.\d+)?)\s*$/);
        if (numeric) {
            const latitude = Number.parseFloat(numeric[1]);
            const longitude = Number.parseFloat(numeric[2]);
            if (Number.isFinite(latitude) && Number.isFinite(longitude) && latitude >= -90 && latitude <= 90 && longitude >= -180 && longitude <= 180) {
                return { latitude, longitude };
            }
        }

        const knownSites = [
            { tokens: ['new york', 'nyc'], latitude: 40.7128, longitude: -74.0060 },
            { tokens: ['san francisco', 'sf', 'bay area'], latitude: 37.7749, longitude: -122.4194 },
            { tokens: ['london'], latitude: 51.5074, longitude: -0.1278 },
            { tokens: ['paris'], latitude: 48.8566, longitude: 2.3522 },
            { tokens: ['berlin'], latitude: 52.5200, longitude: 13.4050 },
            { tokens: ['tokyo'], latitude: 35.6762, longitude: 139.6503 },
            { tokens: ['singapore'], latitude: 1.3521, longitude: 103.8198 },
            { tokens: ['sydney'], latitude: -33.8688, longitude: 151.2093 },
            { tokens: ['toronto'], latitude: 43.6532, longitude: -79.3832 },
            { tokens: ['dubai'], latitude: 25.2048, longitude: 55.2708 }
        ];

        const lowered = text.toLowerCase();
        const known = knownSites.find((site) => site.tokens.some((token) => lowered.includes(token)));
        return known ? { latitude: known.latitude, longitude: known.longitude } : null;
    };

    const deriveCoordinates = (loc, index) => {
        const key = `${loc.name}|${loc.path}|${loc.siteLocation || ''}|${loc.id}`;
        const hash = hashValue(key);
        const base = coordPool[(hash + index) % coordPool.length];
        const latJitter = ((hash % 13) - 6) * 0.35;
        const lngJitter = ((Math.floor(hash / 17) % 13) - 6) * 0.45;

        return {
            latitude: Math.max(-75, Math.min(75, base.lat + latJitter)),
            longitude: Math.max(-170, Math.min(170, base.lng + lngJitter))
        };
    };

    const showEmptyState = (selector, message) => {
        const host = document.querySelector(selector);
        if (!host) return;
        host.innerHTML = `<div class="gv-empty-hint"><i class="bi bi-inbox"></i> ${message}</div>`;
    };

    // ── Leaflet map ───────────────────────────────────────────────
    const mapEl = document.getElementById('globalMap');
    if (mapEl && typeof L !== 'undefined') {
        const map = L.map('globalMap', {
            center: [25, 15],
            zoom: 2,
            zoomControl: false,
            attributionControl: false,
        });

        L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
            maxZoom: 18
        }).addTo(map);

        L.control.zoom({ position: 'bottomright' }).addTo(map);
        L.control.attribution({ position: 'bottomleft', prefix: '© <a href="https://carto.com">CARTO</a>' }).addTo(map);

        const pinIcon = (colour) => L.divIcon({
            className: '',
            html: `<div style="width:12px;height:12px;background:${colour};border:2px solid rgba(255,255,255,0.9);border-radius:50% 50% 50% 0;transform:rotate(-45deg);box-shadow:0 0 10px ${colour}cc;"></div>`,
            iconSize: [12, 12],
            iconAnchor: [6, 12],
            popupAnchor: [0, -14],
        });
        const geoLocations = (locations || []).map((loc, index) => {
            if (Number.isFinite(loc.latitude) && Number.isFinite(loc.longitude)) {
                return loc;
            }

            const resolved = resolveCoordinatesFromSite(loc.siteLocation);
            if (resolved) {
                return {
                    ...loc,
                    ...resolved
                };
            }

            return {
                ...loc,
                ...deriveCoordinates(loc, index)
            };
        });

        if (geoLocations.length === 0) {
            const noLocCtrl = L.control({ position: 'topright' });
            noLocCtrl.onAdd = function () {
                const div = L.DomUtil.create('div', 'gv-map-no-data');
                div.innerHTML = '<i class="bi bi-inbox"></i> No locations configured — add one to see it on the map';
                return div;
            };
            noLocCtrl.addTo(map);
        }

        geoLocations.forEach((loc) => {
            const colour = statusColour[(loc.status || '').toLowerCase()] || '#3ef2d0';
            const marker = L.marker([loc.latitude, loc.longitude], { icon: pinIcon(colour) }).addTo(map);

            const popup = `<div class="gv-popup">
                <div class="gv-popup-title">${loc.name}</div>
                <div class="gv-popup-row">${statusDot(loc.status)}<span>${(loc.status || 'Unknown').toLowerCase() === 'offline' ? 'Error' : (loc.status || 'Unknown')}</span></div>
                <div class="gv-popup-row"><span class="gv-popup-lbl">Type</span> ${loc.type}</div>
                <div class="gv-popup-row"><span class="gv-popup-lbl">Location</span> ${loc.siteLocation || 'Unspecified'}</div>
                <div class="gv-popup-row"><span class="gv-popup-lbl">Path</span> <code>${loc.path}</code></div>
                <div class="gv-popup-row"><span class="gv-popup-lbl">Size</span> ${fmt(loc.totalSizeBytes)}</div>
                <div class="gv-popup-row"><span class="gv-popup-lbl">Files</span> ${fmtNum(loc.fileCount)}</div>
                <div class="gv-popup-row"><span class="gv-popup-lbl">Coordinates</span> ${loc.latitude.toFixed(2)}, ${loc.longitude.toFixed(2)}</div>
            </div>`;

            marker.bindPopup(popup, { maxWidth: 260, className: 'gv-leaflet-popup' });
            marker.on('mouseover', function () { this.openPopup(); });
            marker.on('click', () => {
                document.querySelectorAll('.gv-loc-row').forEach(r => r.classList.remove('gv-loc-row--active'));
                const row = document.querySelector(`[data-loc-id="${loc.id}"]`);
                if (row) { row.classList.add('gv-loc-row--active'); row.scrollIntoView({ block: 'nearest', behavior: 'smooth' }); }
            });
        });
    } else if (mapEl) {
        showEmptyState('#globalMap', 'Map library could not be loaded. Check outbound access to static assets.');
    }

    // ── Storage growth sparkline ──────────────────────────────────
    const tiersCtx = document.getElementById('gvTiersChart');
    if (tiersCtx && typeof Chart !== 'undefined') {
        if (!growthLabels.length || !growthValues.length) {
            showEmptyState('.gv-tier-chart-wrap', 'No live trend data available');
        } else {
            new Chart(tiersCtx, {
                type: 'line',
                data: {
                    labels: growthLabels,
                    datasets: [{
                        data: growthValues,
                        borderColor: '#3ef2d0',
                        backgroundColor: 'rgba(62,242,208,0.12)',
                        fill: true,
                        tension: 0.42,
                        pointRadius: 0,
                        borderWidth: 2,
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: { x: { display: false }, y: { display: false } }
                }
            });
        }
    } else if (tiersCtx) {
        showEmptyState('.gv-tier-chart-wrap', 'Charts are unavailable because Chart.js did not load.');
    }

    // ── File type donut ───────────────────────────────────────────
    const typeCtx = document.getElementById('gvTypeChart');
    if (typeCtx && typeof Chart !== 'undefined') {
        if (!typeLabels.length || !typeValues.length) {
            showEmptyState('.gv-type-chart-wrap', 'No live file type data available');
        } else {
            new Chart(typeCtx, {
                type: 'doughnut',
                data: {
                    labels: typeLabels,
                    datasets: [{
                        data: typeValues,
                        backgroundColor: ['#3ef2d0','#6b8fff','#f5a623','#f45b5b','#a78bfa'],
                        borderWidth: 0, hoverOffset: 4,
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false, cutout: '68%',
                    plugins: {
                        legend: {
                            position: 'right',
                            labels: { color: '#9eb0cd', font: { size: 10, family: 'Manrope', weight: '700' }, boxWidth: 8, padding: 8 }
                        }
                    }
                }
            });
        }
    } else if (typeCtx) {
        showEmptyState('.gv-type-chart-wrap', 'Charts are unavailable because Chart.js did not load.');
    }

    // ── Export / duplicate gauge ──────────────────────────────────
    const exportCtx = document.getElementById('gvExportGauge');
    if (exportCtx && typeof Chart !== 'undefined') {
        new Chart(exportCtx, {
            type: 'doughnut',
            data: {
                datasets: [{
                    data: [dupPct, 100 - dupPct],
                    backgroundColor: ['#3ef2d0','rgba(62,242,208,0.1)'],
                    borderWidth: 0,
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                cutout: '78%', rotation: -90, circumference: 180,
                plugins: { legend: { display: false }, tooltip: { enabled: false } }
            }
        });
    } else if (exportCtx) {
        showEmptyState('.gv-gauge-wrap', 'Gauge is unavailable because Chart.js did not load.');
    }

    // ── Sync profile info from sidebar ───────────────────────────
    const sidebarName = document.getElementById('sidebarProfileName');
    const gvName = document.getElementById('gvProfileName');
    const gvAvatar = document.getElementById('gvAvatar');
    if (sidebarName && gvName) {
        gvName.textContent = sidebarName.textContent.trim() || 'StorageLens';
        const parts = (sidebarName.textContent.trim() || 'SL').split(' ');
        if (gvAvatar) gvAvatar.textContent = parts.map(p => p[0]).join('').slice(0,2).toUpperCase();
    }
}());
</script>
}
