<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Storage Lens</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="icon" type="image/png" href="~/images/storagelens-logo-small.png" asp-append-version="true" />
    <link rel="shortcut icon" type="image/png" href="~/images/storagelens-logo-small.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StorageLens.Web.styles.css" asp-append-version="true" />
</head>
<body class="marketing-body">
    <script>
        (function () {
            var t = localStorage.getItem('storagelens-theme');
            if (!t) {
                localStorage.setItem('storagelens-theme', 'light');
                t = 'light';
            }

            if (t === 'dark') {
                document.body.classList.add('dark-mode');
            }

            function syncMarketingHeaderOffset() {
                var header = document.querySelector('.marketing-header');
                if (!header) {
                    return;
                }

                document.documentElement.style.setProperty('--marketing-header-offset', header.offsetHeight + 'px');
            }

            window.addEventListener('resize', syncMarketingHeaderOffset);
            window.addEventListener('load', syncMarketingHeaderOffset);
            document.addEventListener('DOMContentLoaded', syncMarketingHeaderOffset);

            document.body.classList.add('preload');
            window.addEventListener('load', function () { document.body.classList.remove('preload'); });
        }());
    </script>

    <header class="marketing-header">
        <div class="marketing-container marketing-header-inner">
            <a class="marketing-brand" asp-page="/Index" aria-label="StorageLens landing page">
                <span class="sl-logo sl-logo--marketing" aria-hidden="true">
                    <span class="sl-logo__line sl-logo__line--left"></span>
                    <span class="sl-logo__core">
                        <span class="sl-logo__frame"></span>
                        <span class="sl-logo__bar sl-logo__bar--top"></span>
                        <span class="sl-logo__text">ST<span class="sl-logo__o"></span>RAGELENS</span>
                        <span class="sl-logo__bar sl-logo__bar--bottom"></span>
                    </span>
                    <span class="sl-logo__line sl-logo__line--right"></span>
                </span>
                <span class="marketing-brand-copy">
                    <span class="marketing-brand-subtitle">Storage operations intelligence and automation</span>
                </span>
            </a>

            <nav class="marketing-nav" aria-label="Primary">
                <a href="#product">Product</a>
                <a href="#problems">Problems We Solve</a>
                <a href="#features">Features</a>
                <a href="#how-it-works">How It Works</a>
                <a href="#pricing">Pricing</a>
                <a href="#faq">FAQ</a>
                <a href="#contact">Contact</a>
                <span class="marketing-nav-divider" aria-hidden="true"></span>
                <a asp-page="/GlobalView" class="marketing-nav-app-link"><i class="bi bi-speedometer2" aria-hidden="true"></i> Dashboard</a>
            </nav>

            <div class="marketing-header-actions">
                <button class="btn icon-btn theme-toggle-btn" id="darkModeToggle" type="button" aria-label="Toggle dark mode" aria-pressed="false" title="Switch to dark mode">
                    <i class="bi bi-moon-stars-fill" aria-hidden="true"></i>
                    <span class="theme-toggle-label">Theme</span>
                </button>
                <a class="btn btn-outline-soft marketing-header-link slp-pilot-btn" href="#pricing" aria-label="Start a Pilot">
                    <span class="slp-pilot-btn-default">Start a Pilot</span>
                    <span class="slp-pilot-btn-hover" aria-hidden="true">Plan Your Pilot</span>
                </a>
                <a class="btn btn-gradient marketing-header-cta" href="#contact">Request a Demo</a>
            </div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="marketing-footer">
        <div class="marketing-container marketing-footer-inner">
            <div class="marketing-footer-company">
                <div class="marketing-footer-title">StorageLens</div>
                <p class="marketing-footer-copy mb-0">Storage visibility, analytics, automation, and audit-ready reporting for enterprise teams.</p>
                <p class="marketing-footer-copy mb-0 marketing-footer-contact">Contact: <a href="mailto:sales@storagelens.io">sales@storagelens.io</a></p>
                <p class="marketing-footer-copy mb-0 marketing-footer-legal">&copy; @DateTime.UtcNow.Year StorageLens. All rights reserved.</p>
            </div>
            <nav class="marketing-footer-links" aria-label="Footer navigation">
                <a href="#product">Product</a>
                <a href="#features">Features</a>
                <a href="#pricing">Pricing</a>
                <a href="#faq">FAQ</a>
                <a href="#contact">Contact</a>
                <a href="#">Privacy</a>
                <a href="#">Terms</a>
            </nav>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>