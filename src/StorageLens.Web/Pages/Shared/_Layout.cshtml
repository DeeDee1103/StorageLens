<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Storage Lens</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="icon" type="image/png" href="~/images/storagelens-icon.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StorageLens.Web.styles.css" asp-append-version="true" />
</head>
<body class="app-body">
    <script>
        (function () {
            var t = localStorage.getItem('storagelens-theme');
            var d = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
            if (t === 'dark' || (!t && d)) { document.body.classList.add('dark-mode'); }
            document.body.classList.add('preload');
            window.addEventListener('load', function () { document.body.classList.remove('preload'); });
        }());
    </script>
    @{
        var activeNav = (ViewData["Nav"]?.ToString() ?? "Dashboard").ToLowerInvariant();
    }
    <div class="app-shell">
        <aside class="sidebar-panel" id="sidebarPanel">
            <div class="sidebar-brand text-center py-4">
                <img src="~/images/storagelens-logo.png"
                     alt="StorageLens Logo"
                     class="sidebar-logo">

                <div class="sidebar-title">
                    Storage Intelligence
                </div>
            </div>

            <nav class="menu-nav">
                <a class="menu-link @(activeNav == "home" ? "active" : string.Empty)" asp-page="/Landing"><i class="bi bi-house-door"></i>Home</a>
                <a class="menu-link @(activeNav == "dashboard" ? "active" : string.Empty)" asp-page="/Index"><i class="bi bi-speedometer2"></i>Dashboard</a>
                <a class="menu-link @(activeNav == "locations" ? "active" : string.Empty)" asp-page="/StorageLocations"><i class="bi bi-hdd-stack"></i>Storage Locations</a>
                <a class="menu-link @(activeNav == "scanjobs" ? "active" : string.Empty)" asp-page="/ScanJobs"><i class="bi bi-activity"></i>Scan Jobs</a>
                <a class="menu-link @(activeNav == "fileinventory" ? "active" : string.Empty)" asp-page="/FileInventory"><i class="bi bi-folder2-open"></i>File Inventory</a>
                <a class="menu-link @(activeNav == "duplicates" ? "active" : string.Empty)" asp-page="/Duplicates"><i class="bi bi-files"></i>Duplicates</a>
                <a class="menu-link @(activeNav == "reports" ? "active" : string.Empty)" asp-page="/Reports"><i class="bi bi-graph-up-arrow"></i>Reports</a>
                <a class="menu-link @(activeNav == "pricing" ? "active" : string.Empty)" asp-page="/Pricing"><i class="bi bi-tags"></i>Pricing</a>
                <a class="menu-link @(activeNav == "settings" ? "active" : string.Empty)" asp-page="/Settings"><i class="bi bi-gear"></i>Settings</a>
                <a class="menu-link @(activeNav == "about" ? "active" : string.Empty)" asp-page="/About"><i class="bi bi-info-circle"></i>About</a>
            </nav>

            <div class="sidebar-profile-footer">
                <a class="sidebar-profile-link @(activeNav == "profile" ? "active" : string.Empty)" asp-page="/Profile">
                    <span class="sidebar-profile-avatar" id="sidebarAvatarImg"></span>
                    <div class="sidebar-profile-info">
                        <span class="sidebar-profile-name" id="sidebarProfileName">DeeDee</span>
                        <span class="sidebar-profile-role">Admin</span>
                    </div>
                    <i class="bi bi-chevron-right sidebar-profile-chevron" aria-hidden="true"></i>
                </a>
            </div>
        </aside>

        <section class="main-panel">
            <header class="top-bar">
                <button class="btn btn-light d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarOffcanvas">
                    <i class="bi bi-list"></i>
                </button>
                <div class="search-wrap">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input class="form-control" id="globalSearch" type="search" placeholder="Search files, locations, reports" aria-label="Search" />
                    <kbd class="search-kbd d-none d-md-inline">Ctrl K</kbd>
                </div>
                <div class="top-actions">
                    <button class="btn icon-btn theme-toggle-btn" id="darkModeToggle" type="button" aria-label="Toggle dark mode" aria-pressed="false" title="Switch to dark mode">
                        <i class="bi bi-moon-stars-fill" aria-hidden="true"></i>
                        <span class="theme-toggle-label">Dark Mode</span>
                    </button>
                    <button class="btn icon-btn"><i class="bi bi-bell"></i></button>
                    <div class="dropdown">
                        <button class="btn p-0 border-0 bg-transparent" type="button" id="topbarProfileMenu"
                                data-bs-toggle="dropdown" aria-expanded="false" aria-label="Profile menu">
                            <span class="avatar-badge" id="topbarAvatarImg">DD</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end profile-dropdown shadow" aria-labelledby="topbarProfileMenu">
                            <li class="px-3 py-2 d-flex align-items-center gap-2">
                                <span class="avatar-badge avatar-badge-sm" id="topbarAvatarImgDropdown">DD</span>
                                <div>
                                    <div class="fw-semibold small" id="topbarDropdownName">DeeDee</div>
                                    <div class="text-secondary" style="font-size:0.75rem;" id="topbarDropdownEmail">admin@storagelens.local</div>
                                </div>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li><a class="dropdown-item" asp-page="/Profile"><i class="bi bi-person-circle me-2" aria-hidden="true"></i>My Profile</a></li>
                            <li><a class="dropdown-item" asp-page="/Settings"><i class="bi bi-gear me-2" aria-hidden="true"></i>Settings</a></li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li><span class="dropdown-item text-secondary small"><i class="bi bi-microsoft me-2" aria-hidden="true"></i>Signed in via Microsoft</span></li>
                        </ul>
                    </div>
                </div>
            </header>

            <main role="main" class="content-area">
                @RenderBody()
            </main>

            <footer class="app-footer">
                <span>StorageLens MVP</span>
                <span class="dot-sep">|</span>
                <span>Built on .NET 8 microservices</span>
            </footer>
        </section>
    </div>

    <div class="offcanvas offcanvas-start" tabindex="-1" id="sidebarOffcanvas" aria-labelledby="sidebarOffcanvasLabel">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title" id="sidebarOffcanvasLabel">StorageLens</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <nav class="menu-nav">
                <a class="menu-link @(activeNav == "home" ? "active" : string.Empty)" asp-page="/Landing"><i class="bi bi-house-door"></i>Home</a>
                <a class="menu-link @(activeNav == "dashboard" ? "active" : string.Empty)" asp-page="/Index"><i class="bi bi-speedometer2"></i>Dashboard</a>
                <a class="menu-link @(activeNav == "locations" ? "active" : string.Empty)" asp-page="/StorageLocations"><i class="bi bi-hdd-stack"></i>Storage Locations</a>
                <a class="menu-link @(activeNav == "scanjobs" ? "active" : string.Empty)" asp-page="/ScanJobs"><i class="bi bi-activity"></i>Scan Jobs</a>
                <a class="menu-link @(activeNav == "fileinventory" ? "active" : string.Empty)" asp-page="/FileInventory"><i class="bi bi-folder2-open"></i>File Inventory</a>
                <a class="menu-link @(activeNav == "duplicates" ? "active" : string.Empty)" asp-page="/Duplicates"><i class="bi bi-files"></i>Duplicates</a>
                <a class="menu-link @(activeNav == "reports" ? "active" : string.Empty)" asp-page="/Reports"><i class="bi bi-graph-up-arrow"></i>Reports</a>
                <a class="menu-link @(activeNav == "pricing" ? "active" : string.Empty)" asp-page="/Pricing"><i class="bi bi-tags"></i>Pricing</a>
                <a class="menu-link @(activeNav == "settings" ? "active" : string.Empty)" asp-page="/Settings"><i class="bi bi-gear"></i>Settings</a>
                <a class="menu-link @(activeNav == "about" ? "active" : string.Empty)" asp-page="/About"><i class="bi bi-info-circle"></i>About</a>
                <a class="menu-link @(activeNav == "profile" ? "active" : string.Empty)" asp-page="/Profile"><i class="bi bi-person-circle"></i>Profile</a>
            </nav>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
    <script src="~/js/profile.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>