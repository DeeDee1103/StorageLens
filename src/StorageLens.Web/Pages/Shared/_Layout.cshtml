<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="StorageLens" />
    <meta name="theme-color" content="#0c1422" />
    <title>@ViewData["Title"] - Storage Lens</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="icon" type="image/png" href="~/images/storagelens-logo-small.png" asp-append-version="true" />
    <link rel="shortcut icon" type="image/png" href="~/images/storagelens-logo-small.png" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/locations-search.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StorageLens.Web.styles.css" asp-append-version="true" />
</head>
<body class="app-body">
    <script>
        (function () {
            var uiColorKey = 'sl-ui-color';
            var uiColorCustomKey = 'sl-ui-color-custom';
            var defaultCustom = '#6f64e7';

            function normalizeHex(hex) {
                if (!hex) return defaultCustom;
                var v = String(hex).trim();
                if (v[0] !== '#') v = '#' + v;
                if (/^#[0-9a-fA-F]{3}$/.test(v)) {
                    v = '#' + v[1] + v[1] + v[2] + v[2] + v[3] + v[3];
                }
                return /^#[0-9a-fA-F]{6}$/.test(v) ? v : defaultCustom;
            }

            function mixHex(hexA, hexB, weight) {
                var a = normalizeHex(hexA);
                var b = normalizeHex(hexB);
                var w = Math.max(0, Math.min(1, Number(weight) || 0));
                var ar = parseInt(a.slice(1, 3), 16), ag = parseInt(a.slice(3, 5), 16), ab = parseInt(a.slice(5, 7), 16);
                var br = parseInt(b.slice(1, 3), 16), bg = parseInt(b.slice(3, 5), 16), bb = parseInt(b.slice(5, 7), 16);
                var rr = Math.round(ar + (br - ar) * w);
                var rg = Math.round(ag + (bg - ag) * w);
                var rb = Math.round(ab + (bb - ab) * w);
                var toHex = function (n) { return n.toString(16).padStart(2, '0'); };
                return '#' + toHex(rr) + toHex(rg) + toHex(rb);
            }

            function buildCustomPalette(baseColor) {
                var base = normalizeHex(baseColor);
                var darker = mixHex(base, '#0b1220', 0.34);
                var lighter = mixHex(base, '#ffffff', 0.22);
                var tealish = mixHex(base, '#22c1b4', 0.42);
                var mintish = mixHex(base, '#3ef2d0', 0.48);
                return {
                    '--sl-primary': darker,
                    '--sl-teal': tealish,
                    '--sl-cyan': lighter,
                    '--sl-green': mixHex(base, '#22c55e', 0.4),
                    '--sl-accent': base,
                    '--sl-neon-purple': base,
                    '--sl-neon-blue': lighter,
                    '--sl-neon-turquoise': mintish
                };
            }

            var palettes = {
                azure: {
                    '--sl-primary': '#1165d8',
                    '--sl-teal': '#16b5aa',
                    '--sl-cyan': '#0ea5e9',
                    '--sl-green': '#14b85d',
                    '--sl-accent': '#6f64e7',
                    '--sl-neon-purple': '#7b61ff',
                    '--sl-neon-blue': '#35b9ff',
                    '--sl-neon-turquoise': '#3ef2d0'
                },
                lagoon: {
                    '--sl-primary': '#0f766e',
                    '--sl-teal': '#14b8a6',
                    '--sl-cyan': '#06b6d4',
                    '--sl-green': '#22c55e',
                    '--sl-accent': '#0ea5e9',
                    '--sl-neon-purple': '#22d3ee',
                    '--sl-neon-blue': '#38bdf8',
                    '--sl-neon-turquoise': '#5eead4'
                },
                forest: {
                    '--sl-primary': '#166534',
                    '--sl-teal': '#16a34a',
                    '--sl-cyan': '#22c55e',
                    '--sl-green': '#4ade80',
                    '--sl-accent': '#15803d',
                    '--sl-neon-purple': '#22c55e',
                    '--sl-neon-blue': '#4ade80',
                    '--sl-neon-turquoise': '#86efac'
                },
                sunset: {
                    '--sl-primary': '#b45309',
                    '--sl-teal': '#ea580c',
                    '--sl-cyan': '#f59e0b',
                    '--sl-green': '#f97316',
                    '--sl-accent': '#fb923c',
                    '--sl-neon-purple': '#f97316',
                    '--sl-neon-blue': '#fb923c',
                    '--sl-neon-turquoise': '#fdba74'
                }
            };

            var selectedColor = localStorage.getItem(uiColorKey) || 'azure';
            var customColor = localStorage.getItem(uiColorCustomKey) || defaultCustom;
            var palette = selectedColor === 'custom' ? buildCustomPalette(customColor) : (palettes[selectedColor] || palettes.azure);
            Object.keys(palette).forEach(function (k) { document.documentElement.style.setProperty(k, palette[k]); });

            var t = localStorage.getItem('storagelens-theme');
            var d = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
            if (t === 'dark' || (!t && d)) { document.body.classList.add('dark-mode'); }
            document.body.classList.add('preload');
            window.addEventListener('load', function () { document.body.classList.remove('preload'); });
        }());
    </script>
    @{
        var activeNav = (ViewData["Nav"]?.ToString() ?? "Dashboard").ToLowerInvariant();
    }
    <div class="app-shell">
        <aside class="sidebar-panel" id="sidebarPanel">
            <div class="sidebar-brand text-center py-4">
                <span class="sl-logo sl-logo--sidebar" role="img" aria-label="StorageLens logo">
                    <span class="sl-logo__line sl-logo__line--left"></span>
                    <span class="sl-logo__core">
                        <span class="sl-logo__frame"></span>
                        <span class="sl-logo__bar sl-logo__bar--top"></span>
                        <span class="sl-logo__text">ST<span class="sl-logo__o"></span>RAGELENS</span>
                        <span class="sl-logo__bar sl-logo__bar--bottom"></span>
                    </span>
                    <span class="sl-logo__line sl-logo__line--right"></span>
                </span>

                <div class="sidebar-title">
                    Storage Intelligence
                </div>
            </div>

            <nav class="menu-nav" aria-label="Main navigation">
                <div class="nav-section-label">Overview</div>
                <a class="menu-link @(activeNav == "dashboard" ? "active" : string.Empty)" asp-page="/GlobalView" title="Live operational dashboard — capacity, locations, scan activity, and KPIs."><i class="bi bi-grid-3x3-gap-fill"></i>Dashboard</a>

                <div class="nav-section-label">Operations</div>
                <a class="menu-link @(activeNav == "locations" ? "active" : string.Empty)" asp-page="/StorageLocations" title="Manage monitored storage locations, paths, connection status, and metadata."><i class="bi bi-hdd-network-fill"></i>Storage Locations</a>
                <a class="menu-link @(activeNav == "scanjobs" ? "active" : string.Empty)" asp-page="/ScanJobs" title="Start scans and track current and historical job progress."><i class="bi bi-activity"></i>Scan Jobs</a>
                <a class="menu-link @(activeNav == "flowmanager" ? "active" : string.Empty)" asp-page="/FlowManager" title="Coordinate multi-step storage workflows and orchestration progress."><i class="bi bi-diagram-3-fill"></i>Flow Manager</a>

                <div class="nav-section-label">Data</div>
                <a class="menu-link @(activeNav == "fileinventory" ? "active" : string.Empty)" asp-page="/FileInventory" title="Browse indexed files, metadata, paths, and hash status."><i class="bi bi-folder2-open"></i>File Inventory</a>
                <a class="menu-link @(activeNav == "duplicates" ? "active" : string.Empty)" asp-page="/Duplicates" title="Review duplicate groups and identify reclaimable storage opportunities."><i class="bi bi-copy"></i>Duplicates</a>
                <a class="menu-link @(activeNav == "reports" ? "active" : string.Empty)" asp-page="/Reports" title="Explore analytics views and export report data for offline review."><i class="bi bi-bar-chart-fill"></i>Reports</a>

                <div class="nav-section-label">Insights</div>
                <a class="menu-link @(activeNav == "insights" ? "active" : string.Empty)" asp-page="/Insights" title="Read curated storage insights, trends, and recommendations."><i class="bi bi-lightbulb-fill"></i>Insights</a>
                <a class="menu-link @(activeNav == "alerts" ? "active" : string.Empty)" asp-page="/Alerts" title="Monitor alert conditions and review notification signals."><i class="bi bi-bell-fill"></i>Alerts</a>

                <div class="nav-section-label">Platform</div>
                <a class="menu-link @(activeNav == "pricing" ? "active" : string.Empty)" asp-page="/Pricing" title="Compare plans, included capabilities, and commercial options."><i class="bi bi-credit-card-2-front-fill"></i>Pricing</a>
                <a class="menu-link @(activeNav == "settings" ? "active" : string.Empty)" asp-page="/Settings" title="Configure environment, database, notifications, appearance, and platform settings."><i class="bi bi-sliders2"></i>Settings</a>
                <a class="menu-link @(activeNav == "about" ? "active" : string.Empty)" asp-page="/About" title="Learn about StorageLens, its capabilities, and product background."><i class="bi bi-info-circle-fill"></i>About</a>
            </nav>

            <div class="sidebar-profile-footer">
                <a class="sidebar-profile-link @(activeNav == "profile" ? "active" : string.Empty)" asp-page="/Profile" title="Open your profile, preferences, and subscription details.">
                    <span class="sidebar-profile-avatar" id="sidebarAvatarImg"></span>
                    <div class="sidebar-profile-info">
                        <span class="sidebar-profile-name" id="sidebarProfileName">DeeDee</span>
                        <span class="sidebar-profile-role">Admin</span>
                    </div>
                    <i class="bi bi-chevron-right sidebar-profile-chevron" aria-hidden="true"></i>
                </a>
            </div>
        </aside>

        <section class="main-panel">
            <header class="top-bar">
                <button class="btn btn-light d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarOffcanvas">
                    <i class="bi bi-list"></i>
                </button>
                <div class="top-search-stack">
                    <div class="search-wrap">
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <input class="form-control" id="globalSearch" type="search" placeholder="Search files, locations, reports" aria-label="Search" />
                        <kbd class="search-kbd d-none d-md-inline">Ctrl K</kbd>
                    </div>
                    @if (activeNav == "dashboard")
                    {
                        <div class="top-search-context" aria-hidden="true">
                            <p class="top-search-context-title mb-0">Dashboard</p>
                            <p class="top-search-context-subtitle mb-0">Executive overview of capacity, duplicate waste, and scan performance.</p>
                        </div>
                    }
                </div>
                <div class="top-actions">
                    <button class="btn icon-btn sidebar-toggle-btn d-none d-lg-inline-flex" id="sidebarCompactBtn" type="button" aria-label="Use compact side navigation" aria-controls="sidebarPanel" aria-pressed="false" title="Use compact side navigation">
                        <i class="bi bi-distribute-horizontal" aria-hidden="true"></i>
                        <span class="sidebar-toggle-label">Compact</span>
                    </button>
                    <button class="btn icon-btn sidebar-toggle-btn d-none d-lg-inline-flex" id="sidebarToggleBtn" type="button" aria-label="Hide side navigation" aria-controls="sidebarPanel" aria-expanded="true" title="Hide side navigation">
                        <i class="bi bi-layout-sidebar-inset" aria-hidden="true"></i>
                        <span class="sidebar-toggle-label">Hide Nav</span>
                    </button>
                    <div id="quickActionBtns" class="d-flex gap-1"></div>
                    <button class="btn icon-btn theme-toggle-btn" id="darkModeToggle" type="button" aria-label="Toggle dark mode" aria-pressed="false" title="Switch to dark mode">
                        <i class="bi bi-moon-stars-fill" aria-hidden="true"></i>
                        <span class="theme-toggle-label">Dark Mode</span>
                    </button>
                    <button class="btn icon-btn" aria-label="Notifications" title="Notifications"><i class="bi bi-bell"></i></button>
                    <div class="dropdown">
                        <button class="btn p-0 border-0 bg-transparent" type="button" id="topbarProfileMenu"
                                data-bs-toggle="dropdown" aria-expanded="false" aria-label="Profile menu">
                            <span class="avatar-badge" id="topbarAvatarImg">DD</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end profile-dropdown shadow" aria-labelledby="topbarProfileMenu">
                            <li class="px-3 py-2 d-flex align-items-center gap-2">
                                <span class="avatar-badge avatar-badge-sm" id="topbarAvatarImgDropdown">DD</span>
                                <div>
                                    <div class="fw-semibold small" id="topbarDropdownName">DeeDee</div>
                                    <div class="text-secondary" style="font-size:0.75rem;" id="topbarDropdownEmail">admin@storagelens.local</div>
                                </div>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li><a class="dropdown-item" asp-page="/Profile"><i class="bi bi-person-circle me-2" aria-hidden="true"></i>My Profile</a></li>
                            <li><a class="dropdown-item" asp-page="/Settings"><i class="bi bi-gear me-2" aria-hidden="true"></i>Settings</a></li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li><span class="dropdown-item text-secondary small"><i class="bi bi-microsoft me-2" aria-hidden="true"></i>Signed in via Microsoft</span></li>
                        </ul>
                    </div>
                </div>
            </header>

            <main role="main" class="content-area">
                @RenderBody()
            </main>

            <footer class="app-footer">
                <span>StorageLens</span>
            </footer>
        </section>
    </div>

    <div class="offcanvas offcanvas-start" tabindex="-1" id="sidebarOffcanvas" aria-labelledby="sidebarOffcanvasLabel">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title" id="sidebarOffcanvasLabel">StorageLens</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            <nav class="menu-nav" aria-label="Main navigation">
                <div class="nav-section-label">Overview</div>
                <a class="menu-link @(activeNav == "dashboard" ? "active" : string.Empty)" asp-page="/GlobalView" title="Live operational dashboard."><i class="bi bi-grid-3x3-gap-fill"></i>Dashboard</a>

                <div class="nav-section-label">Operations</div>
                <a class="menu-link @(activeNav == "locations" ? "active" : string.Empty)" asp-page="/StorageLocations" title="Manage monitored storage locations."><i class="bi bi-hdd-network-fill"></i>Storage Locations</a>
                <a class="menu-link @(activeNav == "scanjobs" ? "active" : string.Empty)" asp-page="/ScanJobs" title="Start scans and track job progress."><i class="bi bi-activity"></i>Scan Jobs</a>
                <a class="menu-link @(activeNav == "flowmanager" ? "active" : string.Empty)" asp-page="/FlowManager" title="Coordinate multi-step storage workflows."><i class="bi bi-diagram-3-fill"></i>Flow Manager</a>

                <div class="nav-section-label">Data</div>
                <a class="menu-link @(activeNav == "fileinventory" ? "active" : string.Empty)" asp-page="/FileInventory" title="Browse indexed files and metadata."><i class="bi bi-folder2-open"></i>File Inventory</a>
                <a class="menu-link @(activeNav == "duplicates" ? "active" : string.Empty)" asp-page="/Duplicates" title="Review duplicate groups."><i class="bi bi-copy"></i>Duplicates</a>
                <a class="menu-link @(activeNav == "reports" ? "active" : string.Empty)" asp-page="/Reports" title="Analytics views and export."><i class="bi bi-bar-chart-fill"></i>Reports</a>

                <div class="nav-section-label">Insights</div>
                <a class="menu-link @(activeNav == "insights" ? "active" : string.Empty)" asp-page="/Insights" title="Storage insights and trends."><i class="bi bi-lightbulb-fill"></i>Insights</a>
                <a class="menu-link @(activeNav == "alerts" ? "active" : string.Empty)" asp-page="/Alerts" title="Monitor alert conditions."><i class="bi bi-bell-fill"></i>Alerts</a>

                <div class="nav-section-label">Platform</div>
                <a class="menu-link @(activeNav == "pricing" ? "active" : string.Empty)" asp-page="/Pricing" title="Compare plans."><i class="bi bi-credit-card-2-front-fill"></i>Pricing</a>
                <a class="menu-link @(activeNav == "settings" ? "active" : string.Empty)" asp-page="/Settings" title="Platform settings."><i class="bi bi-sliders2"></i>Settings</a>
                <a class="menu-link @(activeNav == "about" ? "active" : string.Empty)" asp-page="/About" title="About StorageLens."><i class="bi bi-info-circle-fill"></i>About</a>
                <a class="menu-link @(activeNav == "profile" ? "active" : string.Empty)" asp-page="/Profile" title="Your profile."><i class="bi bi-person-circle"></i>Profile</a>
            </nav>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
    <script src="~/js/profile.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>