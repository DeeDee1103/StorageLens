@page "/Index"
@model IndexModel
@{
    var growthLabels = System.Text.Json.JsonSerializer.Serialize(Model.Dashboard.StorageGrowth.Select(x => x.Label));
    var growthValues = System.Text.Json.JsonSerializer.Serialize(Model.Dashboard.StorageGrowth.Select(x => x.Value));
    var typeLabels = System.Text.Json.JsonSerializer.Serialize(Model.Dashboard.FileTypeDistribution.Select(x => x.Label));
    var typeValues = System.Text.Json.JsonSerializer.Serialize(Model.Dashboard.FileTypeDistribution.Select(x => x.Value));
    var locationLabels = System.Text.Json.JsonSerializer.Serialize(Model.Dashboard.LargestLocations.Select(x => x.Label));
    var locationValues = System.Text.Json.JsonSerializer.Serialize(Model.Dashboard.LargestLocations.Select(x => x.Value));
}

<section class="mb-3 reveal-item">
    <h1 class="dashboard-title">Storage Operations Dashboard</h1>
    <p class="text-secondary mb-0">Executive overview of capacity, duplicate waste, and scan performance.</p>
</section>

@if (Model.ServiceUnavailable)
{
    <div class="alert alert-warning d-flex align-items-center gap-2 mb-3 reveal-item" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0" aria-hidden="true"></i>
        <span>Analytics service is currently unavailable. Dashboard data may be incomplete. Please check your service configuration.</span>
    </div>
}

<section class="row g-3 mb-3">
    <div class="col-md-6 col-xl-3 reveal-item">
        <div class="card-premium kpi-card">
            <div class="kpi-icon kpi-icon-blue"><i class="bi bi-hdd-stack" aria-hidden="true"></i></div>
            <div class="kpi-label">Total Storage</div>
            <div class="kpi-value">@SizeFormatter.ToFriendlySize(Model.Dashboard.Kpis.TotalStorageBytes)</div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3 reveal-item">
        <div class="card-premium kpi-card">
            <div class="kpi-icon kpi-icon-teal"><i class="bi bi-files" aria-hidden="true"></i></div>
            <div class="kpi-label">Total Files</div>
            <div class="kpi-value">@Model.Dashboard.Kpis.TotalFiles.ToString("N0")</div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3 reveal-item">
        <div class="card-premium kpi-card">
            <div class="kpi-icon kpi-icon-orange"><i class="bi bi-copy" aria-hidden="true"></i></div>
            <div class="kpi-label">Duplicate Files</div>
            <div class="kpi-value">@Model.Dashboard.Kpis.DuplicatePercent%</div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3 reveal-item">
        <div class="card-premium kpi-card">
            <div class="kpi-icon kpi-icon-green"><i class="bi bi-piggy-bank" aria-hidden="true"></i></div>
            <div class="kpi-label">Potential Savings</div>
            <div class="kpi-value">@SizeFormatter.ToFriendlySize(Model.Dashboard.Kpis.PotentialSavingsBytes)</div>
        </div>
    </div>
</section>

<section class="row g-3 mb-3">
    <div class="col-lg-8 reveal-item">
        <div class="card-premium p-3 h-100">
            <div class="section-title d-flex justify-content-between align-items-center">
                <span>Storage Growth Trend (TB)</span>
                <span class="chart-hint">Click points for details</span>
            </div>
            <div class="chart-box">
                <canvas id="storageGrowthChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4 reveal-item">
        <div class="card-premium p-3 h-100">
            <div class="section-title d-flex justify-content-between align-items-center">
                <span>File Type Distribution</span>
                <span class="chart-hint">Click slices for details</span>
            </div>
            <div class="chart-box">
                <canvas id="fileTypeChart"></canvas>
            </div>
        </div>
    </div>
</section>

<section class="row g-3 mb-3">
    <div class="col-lg-4 reveal-item">
        <div class="card-premium p-3 h-100">
            <div class="section-title">Quick Actions</div>
            <div class="d-grid gap-2">
                <a class="btn btn-gradient" asp-page="/StorageLocations"><i class="bi bi-plus-circle me-1" aria-hidden="true"></i>Add Location</a>
                <a class="btn btn-outline-soft" asp-page="/ScanJobs"><i class="bi bi-play-circle me-1" aria-hidden="true"></i>Start Scan</a>
                <a class="btn btn-outline-soft" asp-page="/Duplicates"><i class="bi bi-files me-1" aria-hidden="true"></i>View Duplicates</a>
                <a class="btn btn-outline-soft" asp-page="/Reports"><i class="bi bi-graph-up-arrow me-1" aria-hidden="true"></i>View Reports</a>
            </div>
        </div>
    </div>
    <div class="col-lg-8 reveal-item">
        <div class="card-premium p-3 h-100">
            <div class="section-title d-flex justify-content-between align-items-center">
                <span>Largest Locations (TB)</span>
                <span class="chart-hint">Click bars for details</span>
            </div>
            <div class="chart-box">
                <canvas id="largestLocationsChart"></canvas>
            </div>
        </div>
    </div>
</section>

<section class="row g-3">
    <div class="col-lg-6 reveal-item">
        <div class="card-premium p-3 h-100">
            <div class="section-title">Recent Scan Jobs</div>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Location</th>
                            <th>Status</th>
                            <th>Files Scanned</th>
                            <th>Progress</th>
                        </tr>
                    </thead>
    <tbody>
                    @if (!Model.Dashboard.RecentJobs.Any())
                    {
                        <tr class="empty-state-row">
                            <td colspan="4"><i class="bi bi-inbox empty-state-icon"></i>No scan jobs yet</td>
                        </tr>
                    }
                    @foreach (var job in Model.Dashboard.RecentJobs)
                    {
                        <tr>
                            <td>@job.LocationName</td>
                            <td>
                                <span class="badge-soft status-badge status-@job.Status.ToLowerInvariant()">@job.Status</span>
                            </td>
                            <td>@job.FilesScanned.ToString("N0")</td>
                            <td>
                                <div class="progress-with-label">
                                    <div class="progress"><div class="progress-bar" style="width:@job.ProgressPercent%"></div></div>
                                    <span class="progress-pct">@job.ProgressPercent%</span>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-6 reveal-item">
        <div class="card-premium p-3 h-100">
            <div class="section-title">Top Duplicate Groups</div>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Example File</th>
                            <th>Count</th>
                            <th>Waste</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (!Model.Dashboard.TopDuplicateGroups.Any())
                    {
                        <tr class="empty-state-row">
                            <td colspan="3"><i class="bi bi-check-circle empty-state-icon"></i>No duplicate groups found</td>
                        </tr>
                    }
                    @foreach (var group in Model.Dashboard.TopDuplicateGroups)
                    {
                        <tr>
                            <td>@group.ExampleFileName</td>
                            <td>@group.FileCount</td>
                            <td>@SizeFormatter.ToFriendlySize(group.WastedBytes)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="chartDetailModal" tabindex="-1" aria-labelledby="chartDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content chart-detail-modal">
            <div class="modal-header">
                <h5 class="modal-title" id="chartDetailModalLabel">Chart Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <ul class="list-unstyled mb-0" id="chartDetailList"></ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const growthLabels = @Html.Raw(growthLabels);
        const growthValues = @Html.Raw(growthValues);
        const typeLabels = @Html.Raw(typeLabels);
        const typeValues = @Html.Raw(typeValues);
        const locationLabels = @Html.Raw(locationLabels);
        const locationValues = @Html.Raw(locationValues);

        if (document.body.classList.contains('dark-mode')) {
            Chart.defaults.color = '#9eb0cd';
            Chart.defaults.borderColor = '#2a3a56';
        }

        const isDarkMode = document.body.classList.contains('dark-mode');
        const modalElement = document.getElementById('chartDetailModal');
        const modalTitleElement = document.getElementById('chartDetailModalLabel');
        const modalListElement = document.getElementById('chartDetailList');
        const chartDetailModal = modalElement ? new bootstrap.Modal(modalElement) : null;

        const darkenHexColor = (hex, intensity = 0.28) => {
            if (typeof hex !== 'string' || !hex.startsWith('#')) {
                return '#1d2f4e';
            }

            const normalized = hex.length === 4
                ? `#${hex[1]}${hex[1]}${hex[2]}${hex[2]}${hex[3]}${hex[3]}`
                : hex;

            const r = Math.max(0, Math.floor(parseInt(normalized.slice(1, 3), 16) * (1 - intensity)));
            const g = Math.max(0, Math.floor(parseInt(normalized.slice(3, 5), 16) * (1 - intensity)));
            const b = Math.max(0, Math.floor(parseInt(normalized.slice(5, 7), 16) * (1 - intensity)));

            return `rgb(${r}, ${g}, ${b})`;
        };

        const formatPercent = (part, whole) => {
            if (!whole) {
                return '0%';
            }

            return `${((Number(part) / Number(whole)) * 100).toFixed(1)}%`;
        };

        const openChartDetails = (title, detailRows) => {
            if (!chartDetailModal || !modalTitleElement || !modalListElement) {
                return;
            }

            modalTitleElement.textContent = title;
            // Clear existing items
            modalListElement.innerHTML = '';

            // Safely append each detail row as text to avoid XSS
            detailRows.forEach((row) => {
                const li = document.createElement('li');
                li.className = 'chart-detail-row';
                li.textContent = String(row);
                modalListElement.appendChild(li);
            });

            chartDetailModal.show();
        };

        const doughnut3dPlugin = {
            id: 'doughnut3dPlugin',
            beforeDatasetDraw(chart, args, pluginOptions) {
                if (chart.config.type !== 'doughnut' || args.index !== 0) {
                    return;
                }

                const meta = chart.getDatasetMeta(args.index);
                const dataset = chart.data.datasets[args.index];
                const depth = pluginOptions?.depth ?? 10;
                const colors = dataset.backgroundColor || [];
                const { ctx } = chart;

                meta.data.forEach((arc, index) => {
                    const props = arc.getProps(['x', 'y', 'innerRadius', 'outerRadius', 'startAngle', 'endAngle'], true);
                    const baseColor = Array.isArray(colors) ? colors[index] : colors;
                    ctx.save();
                    ctx.beginPath();
                    ctx.arc(props.x, props.y + depth, props.outerRadius, props.startAngle, props.endAngle);
                    ctx.arc(props.x, props.y + depth, props.innerRadius, props.endAngle, props.startAngle, true);
                    ctx.closePath();
                    ctx.fillStyle = darkenHexColor(baseColor, isDarkMode ? 0.5 : 0.35);
                    ctx.fill();
                    ctx.restore();
                });
            }
        };

        const bar3dPlugin = {
            id: 'bar3dPlugin',
            afterDatasetDraw(chart, args, pluginOptions) {
                if (chart.config.type !== 'bar' || args.index !== 0) {
                    return;
                }

                const dataset = chart.data.datasets[args.index];
                const bars = chart.getDatasetMeta(args.index).data;
                const depth = pluginOptions?.depth ?? 8;
                const { ctx } = chart;

                bars.forEach((bar, index) => {
                    const props = bar.getProps(['x', 'y', 'base', 'width'], true);
                    const left = props.x - props.width / 2;
                    const right = props.x + props.width / 2;
                    const top = props.y;
                    const base = props.base;
                    const baseColor = Array.isArray(dataset.backgroundColor) ? dataset.backgroundColor[index] : dataset.backgroundColor;
                    const sideColor = darkenHexColor(baseColor, isDarkMode ? 0.52 : 0.38);
                    const topColor = darkenHexColor(baseColor, isDarkMode ? 0.32 : 0.2);

                    ctx.save();

                    ctx.beginPath();
                    ctx.moveTo(right, top);
                    ctx.lineTo(right + depth, top - depth);
                    ctx.lineTo(right + depth, base - depth);
                    ctx.lineTo(right, base);
                    ctx.closePath();
                    ctx.fillStyle = sideColor;
                    ctx.fill();

                    ctx.beginPath();
                    ctx.moveTo(left, top);
                    ctx.lineTo(right, top);
                    ctx.lineTo(right + depth, top - depth);
                    ctx.lineTo(left + depth, top - depth);
                    ctx.closePath();
                    ctx.fillStyle = topColor;
                    ctx.fill();

                    ctx.restore();
                });
            }
        };

        const doughnutPercentLabelsPlugin = {
            id: 'doughnutPercentLabelsPlugin',
            afterDatasetDraw(chart, args) {
                if (chart.config.type !== 'doughnut' || args.index !== 0) {
                    return;
                }

                const dataset = chart.data.datasets[args.index];
                const values = dataset.data || [];
                const total = values.reduce((sum, value) => sum + Number(value), 0);
                const arcs = chart.getDatasetMeta(args.index).data;
                const { ctx } = chart;

                arcs.forEach((arc, index) => {
                    const value = Number(values[index] || 0);
                    const percent = total > 0 ? (value / total) * 100 : 0;
                    if (percent < 5) {
                        return;
                    }

                    const props = arc.getProps(['x', 'y', 'innerRadius', 'outerRadius', 'startAngle', 'endAngle'], true);
                    const angle = (props.startAngle + props.endAngle) / 2;
                    const radius = props.innerRadius + ((props.outerRadius - props.innerRadius) * 0.55);
                    const x = props.x + Math.cos(angle) * radius;
                    const y = props.y + Math.sin(angle) * radius + 8;

                    ctx.save();
                    ctx.fillStyle = '#ffffff';
                    ctx.font = '700 11px Manrope, sans-serif';
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'middle';
                    ctx.fillText(`${percent.toFixed(0)}%`, x, y);
                    ctx.restore();
                });
            }
        };

        const barValueLabelsPlugin = {
            id: 'barValueLabelsPlugin',
            afterDatasetsDraw(chart) {
                if (chart.config.type !== 'bar') {
                    return;
                }

                const dataset = chart.data.datasets[0];
                const bars = chart.getDatasetMeta(0).data;
                const { ctx } = chart;

                bars.forEach((bar, index) => {
                    const value = Number(dataset.data[index] || 0);
                    const props = bar.getProps(['x', 'y'], true);

                    ctx.save();
                    ctx.fillStyle = isDarkMode ? '#d8e4f7' : '#183255';
                    ctx.font = '700 11px Manrope, sans-serif';
                    ctx.textAlign = 'center';
                    ctx.fillText(`${value.toFixed(1)} TB`, props.x + 5, props.y - 8);
                    ctx.restore();
                });
            }
        };

        const line3dPlugin = {
            id: 'line3dPlugin',
            beforeDatasetDraw(chart, args, pluginOptions) {
                if (chart.config.type !== 'line' || args.index !== 0) {
                    return;
                }

                const dataset = chart.data.datasets[args.index];
                const meta = chart.getDatasetMeta(args.index);
                if (!meta?.data?.length) {
                    return;
                }

                const depthX = pluginOptions?.depthX ?? 8;
                const depthY = pluginOptions?.depthY ?? 7;
                const sideStroke = isDarkMode ? 'rgba(84, 130, 209, 0.55)' : 'rgba(14, 63, 141, 0.35)';
                const ridgeStroke = isDarkMode ? 'rgba(159, 197, 255, 0.55)' : 'rgba(255, 255, 255, 0.68)';
                const areaFill = isDarkMode ? 'rgba(23, 84, 170, 0.24)' : 'rgba(17, 101, 216, 0.17)';
                const baseLine = chart.scales.y?.getPixelForValue(0) ?? chart.chartArea.bottom;
                const points = meta.data.map((point) => point.getProps(['x', 'y'], true));
                const { ctx } = chart;

                ctx.save();

                ctx.beginPath();
                ctx.moveTo(points[0].x, points[0].y);
                for (let i = 1; i < points.length; i++) {
                    ctx.lineTo(points[i].x, points[i].y);
                }
                for (let i = points.length - 1; i >= 0; i--) {
                    ctx.lineTo(points[i].x + depthX, points[i].y - depthY);
                }
                ctx.closePath();
                ctx.fillStyle = areaFill;
                ctx.fill();

                ctx.beginPath();
                ctx.moveTo(points[0].x + depthX, points[0].y - depthY);
                for (let i = 1; i < points.length; i++) {
                    ctx.lineTo(points[i].x + depthX, points[i].y - depthY);
                }
                ctx.lineWidth = 2;
                ctx.strokeStyle = ridgeStroke;
                ctx.stroke();

                ctx.lineWidth = 1.2;
                ctx.strokeStyle = sideStroke;
                points.forEach((point) => {
                    ctx.beginPath();
                    ctx.moveTo(point.x, point.y);
                    ctx.lineTo(point.x + depthX, point.y - depthY);
                    ctx.stroke();

                    ctx.beginPath();
                    ctx.moveTo(point.x, baseLine);
                    ctx.lineTo(point.x + depthX, baseLine - depthY);
                    ctx.stroke();
                });

                ctx.restore();
            }
        };

        const lineValueLabelsPlugin = {
            id: 'lineValueLabelsPlugin',
            afterDatasetsDraw(chart) {
                if (chart.config.type !== 'line') {
                    return;
                }

                const dataset = chart.data.datasets[0];
                const points = chart.getDatasetMeta(0).data;
                const { ctx } = chart;

                points.forEach((point, index) => {
                    const value = Number(dataset.data[index] || 0);
                    const props = point.getProps(['x', 'y'], true);

                    ctx.save();
                    ctx.fillStyle = isDarkMode ? '#d8e4f7' : '#183255';
                    ctx.font = '700 10px Manrope, sans-serif';
                    ctx.textAlign = 'center';
                    ctx.fillText(`${value.toFixed(1)} TB`, props.x, props.y - 10);
                    ctx.restore();
                });
            }
        };

        Chart.register(doughnut3dPlugin, bar3dPlugin, doughnutPercentLabelsPlugin, barValueLabelsPlugin, line3dPlugin, lineValueLabelsPlugin);

        const storageGrowthChart = new Chart(document.getElementById("storageGrowthChart"), {
            type: "line",
            data: {
                labels: growthLabels,
                datasets: [{
                    label: "TB",
                    data: growthValues,
                    borderColor: "#1165d8",
                    backgroundColor: "rgba(17,101,216,0.16)",
                    pointBackgroundColor: "#16b5aa",
                    pointBorderColor: "#ffffff",
                    pointBorderWidth: 2,
                    pointRadius: 4,
                    pointHoverRadius: 7,
                    fill: true,
                    tension: 0.35
                }]
            },
            options: {
                maintainAspectRatio: false,
                animation: {
                    duration: 1200,
                    easing: 'easeOutCubic'
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: (value) => `${Number(value).toFixed(0)} TB`
                        }
                    }
                },
                interaction: {
                    mode: 'nearest',
                    intersect: true
                },
                onHover: (event, elements, chart) => {
                    chart.canvas.style.cursor = elements.length ? 'pointer' : 'default';
                },
                onClick: (event, elements) => {
                    if (!elements.length) {
                        return;
                    }

                    const index = elements[0].index;
                    const value = Number(growthValues[index] || 0);
                    const label = growthLabels[index] || 'Unknown period';
                    const previousValue = index > 0 ? Number(growthValues[index - 1] || 0) : null;
                    const delta = previousValue === null ? null : value - previousValue;
                    const deltaText = delta === null
                        ? 'Baseline period'
                        : `${delta >= 0 ? '+' : ''}${delta.toFixed(2)} TB vs previous point`;

                    openChartDetails('Storage Growth Detail', [
                        `<strong>Period:</strong> ${label}`,
                        `<strong>Storage:</strong> ${value.toFixed(2)} TB`,
                        `<strong>Trend:</strong> ${deltaText}`,
                        '<span class="text-secondary">Use this trend point to investigate sudden growth spikes and retention opportunities.</span>'
                    ]);
                },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: (context) => `${Number(context.raw || 0).toFixed(2)} TB`
                        }
                    },
                    line3dPlugin: {
                        depthX: 8,
                        depthY: 7
                    }
                }
            }
        });

        const fileTypeChart = new Chart(document.getElementById("fileTypeChart"), {
            type: "doughnut",
            data: {
                labels: typeLabels,
                datasets: [{
                    data: typeValues,
                    backgroundColor: ["#1165d8", "#16b5aa", "#6f64e7", "#14b85d", "#0ea5e9", "#26a69a"],
                    borderWidth: 0,
                    hoverOffset: 8
                }]
            },
            options: {
                maintainAspectRatio: false,
                cutout: '56%',
                animation: {
                    duration: 1100,
                    easing: 'easeOutQuart'
                },
                onHover: (event, elements, chart) => {
                    chart.canvas.style.cursor = elements.length ? 'pointer' : 'default';
                },
                onClick: (event, elements) => {
                    if (!elements.length) {
                        return;
                    }

                    const index = elements[0].index;
                    const value = Number(typeValues[index] || 0);
                    const total = typeValues.reduce((sum, item) => sum + Number(item || 0), 0);
                    const label = typeLabels[index] || 'Unknown';

                    openChartDetails('File Type Distribution', [
                        `<strong>Type:</strong> ${label}`,
                        `<strong>Share:</strong> ${formatPercent(value, total)}`,
                        `<strong>Volume Index:</strong> ${value.toLocaleString()}`,
                        '<span class="text-secondary">Use this to identify dominant formats driving storage growth.</span>'
                    ]);
                },
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            boxWidth: 12,
                            usePointStyle: true,
                            pointStyle: 'circle'
                        }
                    },
                    tooltip: {
                        callbacks: {
                            label: (context) => {
                                const total = context.dataset.data.reduce((sum, item) => sum + Number(item || 0), 0);
                                const value = Number(context.raw || 0);
                                return `${context.label}: ${formatPercent(value, total)}`;
                            }
                        }
                    },
                    doughnut3dPlugin: {
                        depth: 10
                    }
                }
            }
        });

        const largestLocationsChart = new Chart(document.getElementById("largestLocationsChart"), {
            type: "bar",
            data: {
                labels: locationLabels,
                datasets: [{
                    data: locationValues,
                    backgroundColor: "#16b5aa",
                    borderRadius: 6,
                    borderSkipped: false
                }]
            },
            options: {
                maintainAspectRatio: false,
                animation: {
                    duration: 1200,
                    easing: 'easeOutCubic'
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: (value) => `${Number(value).toFixed(0)} TB`
                        }
                    }
                },
                onHover: (event, elements, chart) => {
                    chart.canvas.style.cursor = elements.length ? 'pointer' : 'default';
                },
                onClick: (event, elements) => {
                    if (!elements.length) {
                        return;
                    }

                    const index = elements[0].index;
                    const value = Number(locationValues[index] || 0);
                    const total = locationValues.reduce((sum, item) => sum + Number(item || 0), 0);
                    const label = locationLabels[index] || 'Unknown';

                    openChartDetails('Largest Location Details', [
                        `<strong>Location:</strong> ${label}`,
                        `<strong>Storage:</strong> ${value.toFixed(2)} TB`,
                        `<strong>Share of top locations:</strong> ${formatPercent(value, total)}`,
                        '<span class="text-secondary">Review this location for data lifecycle, cleanup, and archival opportunities.</span>'
                    ]);
                },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: (context) => `${Number(context.raw || 0).toFixed(2)} TB`
                        }
                    },
                    bar3dPlugin: {
                        depth: 8
                    }
                }
            }
        });
    </script>
}
