@page
@model StorageLocationsModel

<section class="mb-3 reveal-item">
    <h1 class="dashboard-title">Storage Locations</h1>
    <p class="text-secondary mb-0">Manage NAS paths, local drives, and file shares monitored by StorageLens.</p>
</section>

<section class="card-premium p-3 mb-3 reveal-item">
    <div class="section-title">Add Location</div>
    <form method="post" asp-page-handler="Add" class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Name</label>
            <input class="form-control" asp-for="Name" required />
        </div>
        <div class="col-md-4">
            <label class="form-label">Path</label>
            <input class="form-control" asp-for="Path" required placeholder="\\nas01\share\folder" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Type</label>
            <select class="form-select" asp-for="Type" asp-items="Html.GetEnumSelectList<StorageLocationType>()"></select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-gradient w-100">Add Location</button>
        </div>
    </form>
</section>

<section class="card-premium p-3 reveal-item">
    <div class="section-title">Configured Locations</div>
    <div class="table-responsive">
        <table class="table align-middle locations-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Path</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Last Scan</th>
                    <th>Total Size</th>
                    <th>Total Used</th>
                    <th>% Remaining</th>
                    <th>File Count</th>
                    <th class="actions-col">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var location in Model.Locations)
            {
                var fileUrl = ToFileUrl(location.Path);
                var spaceMetrics = GetSpaceMetrics(location.Path);
                <tr>
                    <td>@location.Name</td>
                    <td>
                        <div class="path-actions">
                            <a href="@fileUrl" class="path-link storage-path-link" data-path="@location.Path" onclick="return openStoragePath(event);" title="Open @location.Path">
                                <code>@location.Path</code>
                            </a>
                            <button type="button"
                                    class="btn copy-path-btn"
                                    data-path="@location.Path"
                                    onclick="return copyStoragePath(event);"
                                    title="Copy path"
                                    aria-label="Copy path for @location.Name">
                                <i class="bi bi-clipboard copy-path-icon" aria-hidden="true"></i>
                            </button>
                        </div>
                    </td>
                    <td>@location.Type</td>
                    <td>
                        <span class="badge-soft status-badge status-@location.Status.ToLowerInvariant()">@location.Status</span>
                    </td>
                    <td>@(location.LastScanDate?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                    <td>
                        @if (spaceMetrics.TotalBytes is long totalBytes)
                        {
                            @SizeFormatter.ToFriendlySize(totalBytes)
                        }
                        else
                        {
                            <span class="text-secondary">N/A</span>
                        }
                    </td>
                    <td>@SizeFormatter.ToFriendlySize(location.TotalSizeBytes)</td>
                    <td>
                        @if (spaceMetrics.PercentRemaining is double remainingPercent)
                        {
                            <span class="badge-soft">@remainingPercent.ToString("N1")%</span>
                        }
                        else
                        {
                            <span class="text-secondary">N/A</span>
                        }
                    </td>
                    <td>@location.FileCount.ToString("N0")</td>
                    <td class="actions-cell">
                        <div class="locations-actions">
                        <form method="post" asp-page-handler="StartScan" class="d-inline">
                            <input type="hidden" name="locationId" value="@location.Id" />
                            <button type="submit" class="btn btn-start-scan-location btn-sm"
                                    title="Start scan"
                                    aria-label="Start scan for @location.Name">
                                <i class="bi bi-play-fill" aria-hidden="true"></i>
                            </button>
                        </form>
                        <form method="post" asp-page-handler="Delete" class="d-inline ms-1"
                              onsubmit="return confirm('Delete this location? This action cannot be undone.');">
                            <input type="hidden" name="locationId" value="@location.Id" />
                            <button type="submit" class="btn btn-delete-location btn-sm" title="Delete location" aria-label="Delete location @location.Name">
                                <i class="bi bi-trash-fill delete-location-icon" aria-hidden="true"></i>
                            </button>
                        </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>

@functions {
    private readonly record struct SpaceMetrics(long? TotalBytes, double? PercentRemaining);

    private static SpaceMetrics GetSpaceMetrics(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return new SpaceMetrics(null, null);
        }

        try
        {
            var rootPath = System.IO.Path.GetPathRoot(path.Trim());
            if (string.IsNullOrWhiteSpace(rootPath))
            {
                return new SpaceMetrics(null, null);
            }

            var driveInfo = new System.IO.DriveInfo(rootPath);
            if (!driveInfo.IsReady || driveInfo.TotalSize <= 0)
            {
                return new SpaceMetrics(null, null);
            }

            var percentRemaining = (driveInfo.AvailableFreeSpace * 100d) / driveInfo.TotalSize;
            return new SpaceMetrics(driveInfo.TotalSize, percentRemaining);
        }
        catch
        {
            return new SpaceMetrics(null, null);
        }
    }

    private static string ToFileUrl(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return "#";
        }

        var trimmed = path.Trim();

        // UNC share (e.g. \\server\share) should map to file://server/share
        if (trimmed.StartsWith("\\\\", StringComparison.Ordinal))
        {
            var uncPath = trimmed.TrimStart('\\').Replace('\\', '/');
            // Windows browsers are often more successful with UNC links as file://///server/share/path
            return $"file://///{uncPath}";
        }

        // Local Windows path (e.g. C:\folder) should map to file:///C:/folder
        var localPath = trimmed.Replace('\\', '/');
        return $"file:///{localPath}";
    }
}
