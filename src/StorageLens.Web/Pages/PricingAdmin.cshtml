@page
@model PricingAdminModel

<section class="mb-3 reveal-item">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-2">
            <li class="breadcrumb-item"><a asp-page="/Settings">Settings</a></li>
            <li class="breadcrumb-item active" aria-current="page">Pricing Admin</li>
        </ol>
    </nav>
    <h1 class="dashboard-title">Pricing Admin</h1>
    <p class="text-secondary mb-0">Configure pricing tiers and the services available to customers. Changes are owner-only and write to the selected appsettings file.</p>
</section>

@if (Model.SuccessMessage is not null)
{
    <div class="alert alert-success alert-dismissible fade show reveal-item" role="alert">
        <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>@Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger alert-dismissible fade show reveal-item" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>@Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@* ══════════════════════════════════════════════════════════════════════════
   OWNER LOCK SCREEN — shown when cookie is not present
   ══════════════════════════════════════════════════════════════════════════ *@
@if (!Model.IsOwnerAuthenticated)
{
    <div class="row justify-content-center reveal-item">
        <div class="col-md-5 col-lg-4">
            <div class="card-premium p-4 text-center">
                <div class="kpi-icon kpi-icon-orange mx-auto mb-3" style="width:3rem;height:3rem;font-size:1.4rem;">
                    <i class="bi bi-shield-lock-fill" aria-hidden="true"></i>
                </div>
                <h5 class="mb-1">Owner Access Required</h5>
                <p class="text-secondary small mb-4">
                    Pricing configuration is restricted to the application owner.
                    Enter the owner PIN to unlock editing.
                </p>
                <form method="post" asp-page-handler="Unlock">
                    <div class="mb-3 text-start">
                        <label class="form-label" for="OwnerPin">Owner PIN</label>
                        <input class="form-control" id="OwnerPin" name="OwnerPin" type="password"
                               placeholder="Enter owner PIN" autocomplete="current-password" required />
                    </div>
                    <button class="btn btn-gradient w-100" type="submit">
                        <i class="bi bi-unlock me-1" aria-hidden="true"></i>Unlock
                    </button>
                </form>
                <div class="mt-3">
                    <a asp-page="/Pricing" class="text-secondary small">
                        <i class="bi bi-eye me-1" aria-hidden="true"></i>View public pricing page
                    </a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    @* ══════════════════════════════════════════════════════════════════════
       OWNER ADMIN UI
       ══════════════════════════════════════════════════════════════════════ *@

    <!-- Environment strip + lock button -->
    <div class="d-flex align-items-center gap-2 mb-3 reveal-item flex-wrap">
        <span class="text-secondary small"><i class="bi bi-pencil-square me-1"></i>Editing:</span>
        @if (Model.SelectedEditEnvironment == "Production")
        {
            <span class="badge bg-danger bg-opacity-20 text-danger">Production &mdash; saves to <code>appsettings.Production.json</code></span>
        }
        else
        {
            <span class="badge bg-primary bg-opacity-20 text-primary">Development &mdash; saves to <code>appsettings.Development.json</code></span>
        }
        <a asp-page="/EnvironmentSettings" class="btn btn-sm btn-outline-secondary ms-auto me-2">
            <i class="bi bi-toggles me-1"></i>Switch env
        </a>
        <form method="post" asp-page-handler="Lock" class="d-inline">
            <button class="btn btn-sm btn-outline-warning" type="submit">
                <i class="bi bi-lock me-1"></i>Lock
            </button>
        </form>
    </div>

    <!-- ═══ 0. ACTIVE SUBSCRIPTION TIER ════════════════════════════════════ -->
    <div class="card-premium p-4 mb-4 reveal-item">
        <div class="d-flex align-items-center gap-2 mb-1">
            <div class="kpi-icon kpi-icon-orange mb-0"><i class="bi bi-patch-check" aria-hidden="true"></i></div>
            <h5 class="mb-0">Active Subscription Tier</h5>
        </div>
        <p class="text-secondary small mb-3">
            Set which pricing tier this installation is currently subscribed to.
            This controls which features are available across the application.
            Leave blank to disable tier enforcement (all features unlocked).
        </p>

        <form method="post" asp-page-handler="SetActiveTier">
            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label" for="activeTierSelect">Current Tier</label>
                    <select class="form-select" id="activeTierSelect" name="activeTierId">
                        <option value="">— None (all features unlocked) —</option>
                        @foreach (var tier in Model.Tiers)
                        {
                            var isSelected = string.Equals(tier.Id, Model.ActiveTierId, StringComparison.OrdinalIgnoreCase);
                            var priceLabel = tier.IsContactUs
                                ? "(Contact Us)"
                                : $"(${tier.ComputedMonthlyPrice(Model.AvailableServices).ToString("0.##")}/mo)";
                            if (isSelected)
                            {
                                <option value="@tier.Id" selected>@tier.Name @priceLabel</option>
                            }
                            else
                            {
                                <option value="@tier.Id">@tier.Name @priceLabel</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <button class="btn btn-primary btn-sm" type="submit">
                        <i class="bi bi-floppy me-1" aria-hidden="true"></i>Save Active Tier
                    </button>
                </div>
                @if (!string.IsNullOrEmpty(Model.ActiveTierId))
                {
                    var activeTier = Model.Tiers.FirstOrDefault(t => string.Equals(t.Id, Model.ActiveTierId, StringComparison.OrdinalIgnoreCase));
                    if (activeTier is not null)
                    {
                        <div class="col-12">
                            <div class="d-flex flex-wrap gap-1 mt-1">
                                <span class="text-secondary small me-1">Included services:</span>
                                @foreach (var svcId in activeTier.IncludedServiceIds)
                                {
                                    var svc = Model.AvailableServices.FirstOrDefault(s => s.Id == svcId);
                                    if (svc is not null)
                                    {
                                        <span class="badge bg-success bg-opacity-15 text-success">
                                            <i class="bi @svc.Icon me-1" aria-hidden="true"></i>@svc.Name
                                        </span>
                                    }
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </form>
    </div>

    <!-- ═══ 1. PRICING TIERS ══════════════════════════════════════════════ -->
    <div class="card-premium p-4 mb-4 reveal-item">
        <div class="d-flex align-items-center gap-2 mb-1">
            <div class="kpi-icon kpi-icon-blue mb-0"><i class="bi bi-tags" aria-hidden="true"></i></div>
            <h5 class="mb-0">Pricing Tiers</h5>
        </div>
        <p class="text-secondary small mb-3">
            Edit each tier's name, description, price, and which services are included.
            Toggle <strong>Calculated price</strong> to derive the price from service prices automatically.
        </p>

        <div class="accordion" id="tiersAccordion">
            @for (var i = 0; i < Model.Tiers.Count; i++)
            {
                var tier = Model.Tiers[i];
                var collapseId = $"tier-collapse-{i}";
                var headingId = $"tier-heading-{i}";
                var price = tier.ComputedMonthlyPrice(Model.AvailableServices);

                <div class="accordion-item border mb-2 rounded-3 overflow-hidden">
                    <h2 class="accordion-header" id="@headingId">
                        <button class="accordion-button collapsed fw-semibold" type="button"
                                data-bs-toggle="collapse" data-bs-target="#@collapseId"
                                aria-expanded="false" aria-controls="@collapseId">
                            <span class="me-2">@tier.Name</span>
                            @if (tier.IsContactUs)
                            {
                                <span class="badge bg-secondary bg-opacity-20 text-secondary">Contact Us</span>
                            }
                            else
                            {
                                <span class="badge bg-success bg-opacity-15 text-success">$@price.ToString("0.##")/mo</span>
                            }
                            @if (tier.IsPopular)
                            {
                                <span class="badge bg-warning bg-opacity-20 text-warning ms-1">Popular</span>
                            }
                        </button>
                    </h2>
                    <div id="@collapseId" class="accordion-collapse collapse" aria-labelledby="@headingId">
                        <div class="accordion-body">
                            <form method="post" asp-page-handler="SaveTier">
                                <input type="hidden" name="tierId" value="@tier.Id" />

                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label class="form-label" for="tierName-@i">Tier Name</label>
                                        <input class="form-control" id="tierName-@i" name="tierName"
                                               type="text" value="@tier.Name" required />
                                    </div>
                                    <div class="col-md-8">
                                        <label class="form-label" for="tierDesc-@i">Description</label>
                                        <input class="form-control" id="tierDesc-@i" name="tierDescription"
                                               type="text" value="@tier.Description" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label" for="tierHighlight-@i">Highlight Tagline</label>
                                        <input class="form-control" id="tierHighlight-@i" name="tierHighlight"
                                               type="text" value="@tier.Highlight" placeholder="e.g. Up to 10 storage locations" />
                                    </div>
                                    <div class="col-md-3 d-flex align-items-end gap-3 flex-wrap">
                                        <div class="form-check mb-2">
                                            <input class="form-check-input" type="checkbox" id="tierPopular-@i"
                                                   name="tierIsPopular" value="true" @(tier.IsPopular ? "checked" : "") />
                                            <label class="form-check-label" for="tierPopular-@i">Most Popular</label>
                                        </div>
                                        <div class="form-check mb-2">
                                            <input class="form-check-input" type="checkbox" id="tierContact-@i"
                                                   name="tierIsContactUs" value="true" @(tier.IsContactUs ? "checked" : "")
                                                   data-tier-index="@i"
                                                   onchange="toggleTierPriceFields(this.dataset.tierIndex, this.checked)" />
                                            <label class="form-check-label" for="tierContact-@i">Contact Us</label>
                                        </div>
                                    </div>
                                    <div class="col-md-3" id="tierPriceFields-@i" @(tier.IsContactUs ? "style=\"display:none\"" : "")>
                                        <div class="form-check mb-1">
                                            <input class="form-check-input" type="checkbox" id="tierCalcPrice-@i"
                                                   name="tierUseCalculatedPrice" value="true"
                                                   @(tier.UseCalculatedPrice ? "checked" : "")
                                                   data-tier-index="@i"
                                                   onchange="toggleManualPrice(this.dataset.tierIndex, !this.checked)" />
                                            <label class="form-check-label small" for="tierCalcPrice-@i">Calculated price</label>
                                        </div>
                                        <div id="manualPriceWrap-@i" @(tier.UseCalculatedPrice ? "style=\"display:none\"" : "")>
                                            <label class="form-label" for="tierManualPrice-@i">Manual price ($/mo)</label>
                                            <input class="form-control" id="tierManualPrice-@i" name="tierManualMonthlyPrice"
                                                   type="number" step="0.01" min="0"
                                                   value="@tier.ManualMonthlyPrice.ToString("0.##")" />
                                        </div>
                                    </div>
                                </div>

                                <!-- Included services -->
                                <div class="mt-3">
                                    <label class="form-label fw-semibold small text-secondary text-uppercase" style="letter-spacing:.04em;">
                                        Included Services
                                    </label>
                                    <div class="row g-2">
                                        @foreach (var svc in Model.AvailableServices)
                                        {
                                            var isIncluded = tier.IncludedServiceIds.Contains(svc.Id, StringComparer.OrdinalIgnoreCase);
                                            <div class="col-md-4 col-lg-3">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox"
                                                           id="svc-@i-@svc.Id" name="includedServiceIds"
                                                           value="@svc.Id" @(isIncluded ? "checked" : "") />
                                                    <label class="form-check-label small" for="svc-@i-@svc.Id">
                                                        <i class="bi @svc.Icon me-1 text-secondary" aria-hidden="true"></i>@svc.Name
                                                        @if (svc.MonthlyPrice > 0)
                                                        {
                                                            <span class="text-secondary">(+$@svc.MonthlyPrice.ToString("0.##")/mo)</span>
                                                        }
                                                    </label>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="d-flex gap-2 mt-3">
                                    <button class="btn btn-primary btn-sm" type="submit">
                                        <i class="bi bi-floppy me-1" aria-hidden="true"></i>Save Tier
                                    </button>
                                    <a asp-page="/Pricing" class="btn btn-outline-secondary btn-sm">
                                        <i class="bi bi-eye me-1" aria-hidden="true"></i>Preview
                                    </a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- ═══ 2. AVAILABLE SERVICES ═════════════════════════════════════════ -->
    <div class="card-premium p-4 mb-4 reveal-item">
        <div class="d-flex align-items-center gap-2 mb-1">
            <div class="kpi-icon kpi-icon-teal mb-0"><i class="bi bi-grid-3x3-gap" aria-hidden="true"></i></div>
            <h5 class="mb-0">Available Services</h5>
        </div>
        <p class="text-secondary small mb-3">
            Edit existing services or add new ones. New services appear in all tier checklists above.
            Set a price of <strong>$0</strong> for features bundled at no extra cost.
        </p>

        <div class="table-responsive mb-3">
            <table class="table table-sm table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Icon class</th>
                        <th class="text-end">Price ($/mo)</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var svc in Model.AvailableServices)
                    {
                        <tr>
                            <td class="text-secondary small"><code>@svc.Id</code></td>
                            <td>
                                <i class="bi @svc.Icon me-1 text-secondary" aria-hidden="true"></i>@svc.Name
                            </td>
                            <td class="text-secondary small">@svc.Description</td>
                            <td><code class="small">@svc.Icon</code></td>
                            <td class="text-end">@(svc.MonthlyPrice > 0 ? $"${svc.MonthlyPrice:0.##}" : "—")</td>
                            <td>
                                <button class="btn btn-sm btn-outline-secondary" type="button"
                                        data-bs-toggle="modal" data-bs-target="#editServiceModal"
                                        data-svc-id="@svc.Id"
                                        data-svc-name="@svc.Name"
                                        data-svc-desc="@svc.Description"
                                        data-svc-icon="@svc.Icon"
                                        data-svc-price="@svc.MonthlyPrice.ToString("0.##")">
                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Add new service -->
        <details class="mt-2">
            <summary class="fw-semibold small text-primary" style="cursor:pointer;">
                <i class="bi bi-plus-circle me-1" aria-hidden="true"></i>Add new service
            </summary>
            <div class="mt-3">
                <form method="post" asp-page-handler="AddService">
                    <div class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label" for="newSvcId">ID <span class="text-muted small">(slug)</span></label>
                            <input class="form-control" id="newSvcId" name="newServiceId" type="text"
                                   placeholder="e.g. cloud-backup" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="newSvcName">Name</label>
                            <input class="form-control" id="newSvcName" name="newServiceName" type="text"
                                   placeholder="Cloud Backup" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="newSvcDesc">Description</label>
                            <input class="form-control" id="newSvcDesc" name="newServiceDescription" type="text"
                                   placeholder="Short description of the service" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label" for="newSvcPrice">Price ($/mo)</label>
                            <input class="form-control" id="newSvcPrice" name="newServiceMonthlyPrice"
                                   type="number" step="0.01" min="0" value="0" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="newSvcIcon">Bootstrap Icon class</label>
                            <input class="form-control" id="newSvcIcon" name="newServiceIcon" type="text"
                                   placeholder="bi-check-circle" />
                        </div>
                        <div class="col-12">
                            <button class="btn btn-primary btn-sm" type="submit">
                                <i class="bi bi-plus me-1" aria-hidden="true"></i>Add Service
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </details>
    </div>
}

<!-- ── Edit Service Modal ─────────────────────────────────────────────────── -->
@if (Model.IsOwnerAuthenticated)
{
    <div class="modal fade" id="editServiceModal" tabindex="-1" aria-labelledby="editServiceModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form method="post" asp-page-handler="SaveService">
                    <div class="modal-header">
                        <h5 class="modal-title" id="editServiceModalLabel">Edit Service</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="editSvcId" name="serviceId" />
                        <div class="mb-3">
                            <label class="form-label" for="editSvcName">Name</label>
                            <input class="form-control" id="editSvcName" name="serviceName" type="text" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="editSvcDesc">Description</label>
                            <input class="form-control" id="editSvcDesc" name="serviceDescription" type="text" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="editSvcIcon">Bootstrap Icon class</label>
                            <input class="form-control" id="editSvcIcon" name="serviceIcon" type="text" placeholder="bi-check-circle" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="editSvcPrice">Monthly Price (USD)</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input class="form-control" id="editSvcPrice" name="serviceMonthlyPrice"
                                       type="number" step="0.01" min="0" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-floppy me-1" aria-hidden="true"></i>Save Service
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
    // Populate edit-service modal from data attributes
    document.addEventListener('DOMContentLoaded', function () {
        var modal = document.getElementById('editServiceModal');
        if (!modal) return;
        modal.addEventListener('show.bs.modal', function (event) {
            var btn = event.relatedTarget;
            document.getElementById('editSvcId').value = btn.getAttribute('data-svc-id');
            document.getElementById('editSvcName').value = btn.getAttribute('data-svc-name');
            document.getElementById('editSvcDesc').value = btn.getAttribute('data-svc-desc');
            document.getElementById('editSvcIcon').value = btn.getAttribute('data-svc-icon');
            document.getElementById('editSvcPrice').value = btn.getAttribute('data-svc-price');
        });
    });

    function toggleTierPriceFields(index, isContactUs) {
        var el = document.getElementById('tierPriceFields-' + index);
        if (el) el.style.display = isContactUs ? 'none' : '';
    }

    function toggleManualPrice(index, show) {
        var el = document.getElementById('manualPriceWrap-' + index);
        if (el) el.style.display = show ? '' : 'none';
    }
</script>
}
