@page
@model InsightsModel

<section class="mb-3 reveal-item">
    <h1 class="dashboard-title">Storage Lens Insights</h1>
    <p class="text-secondary mb-0">Operational insights to investigate issues quickly and guide first-line troubleshooting.</p>
</section>

<section class="row g-3 reveal-item">
    <div class="col-md-6 col-lg-4">
        <a asp-page="/Logging" class="text-decoration-none">
            <div class="card-premium p-3 h-100 d-flex flex-column insights-card insights-card--logging">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="kpi-icon kpi-icon-blue mb-0"><i class="bi bi-journal-text" aria-hidden="true"></i></div>
                    <h5 class="mb-0">Logging</h5>
                </div>
                <p class="text-secondary small flex-grow-1 mb-2">
                    Investigate errors with structured log fields, exception details, user-friendly explanations,
                    and resolution steps for common issues.
                </p>
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <span class="badge text-bg-light">Interactive filters</span>
                    <span class="badge text-bg-light">Exception guidance</span>
                    <span class="badge text-bg-light">Resolution playbooks</span>
                </div>
                <span class="badge bg-primary bg-opacity-15 text-primary align-self-start">Open Logging &rsaquo;</span>
            </div>
        </a>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="card-premium p-3 h-100 d-flex flex-column insights-card">
            <div class="d-flex align-items-center gap-2 mb-2">
                <div class="kpi-icon kpi-icon-teal mb-0"><i class="bi bi-shield-check" aria-hidden="true"></i></div>
                <h5 class="mb-0">Health Trends</h5>
            </div>
            <p class="text-secondary small flex-grow-1 mb-3">
                Service health trend panels and alert correlations are being finalized for a future update.
            </p>
            <span class="badge bg-secondary bg-opacity-25 text-secondary align-self-start">Coming soon</span>
        </div>
    </div>

    <div class="col-md-6 col-lg-4">
        <div class="card-premium p-3 h-100 d-flex flex-column insights-card">
            <div class="d-flex align-items-center gap-2 mb-2">
                <div class="kpi-icon kpi-icon-green mb-0"><i class="bi bi-lightbulb" aria-hidden="true"></i></div>
                <h5 class="mb-0">Smart Recommendations</h5>
            </div>
            <p class="text-secondary small flex-grow-1 mb-3">
                Automated suggestions for storage optimization and reliability tuning are planned.
            </p>
            <span class="badge bg-secondary bg-opacity-25 text-secondary align-self-start">Coming soon</span>
        </div>
    </div>
</section>
