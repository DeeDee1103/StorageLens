    const count = selectedFiles.length;
    document.getElementById('fmSelectSummary').textContent = count === 0 ? '0 items selected' : `${count} item${count !== 1 ? 's' : ''} selected`;
    document.getElementById('fmSelPillText').textContent = `${count} file${count !== 1 ? 's' : ''} selected`;
    document.getElementById('fmStep2Next').disabled = count === 0;
    document.querySelector('#fmSelectionPill').classList.toggle('fm-selection-pill--active', count > 0);
};

