@page
@model FlowManagerModel
@using System.Text.Json

@{
    var locationsJson = JsonSerializer.Serialize(Model.Dashboard.Locations.Select(l => new {
        id = l.Id, name = l.Name, path = l.Path, type = l.Type,
        status = l.Status, totalSizeBytes = l.TotalSizeBytes,
        fileCount = l.FileCount, lastScanDate = l.LastScanDate
    }));
    var recentJobsJson = JsonSerializer.Serialize(Model.Dashboard.RecentJobs.Select(j => new {
        id = j.Id, locationName = j.LocationName, status = j.Status,
        filesScanned = j.FilesScanned, progressPercent = j.ProgressPercent
    }));
    var kpisJson = JsonSerializer.Serialize(new {
        totalStorageBytes = Model.Dashboard.Kpis.TotalStorageBytes,
        totalFiles = Model.Dashboard.Kpis.TotalFiles,
        duplicatePercent = Model.Dashboard.Kpis.DuplicatePercent,
        potentialSavingsBytes = Model.Dashboard.Kpis.PotentialSavingsBytes
    });
    var typeDistJson = JsonSerializer.Serialize(Model.Dashboard.FileTypeDistribution.Select(x => new { label = x.Label, value = x.Value }));
}

<div class="fm-shell reveal-item">

    <!-- Step indicator bar -->
    <div class="fm-step-bar">
        <div class="fm-step fm-step--active" data-fm-step-indicator="1">
            <div class="fm-step-circle"><i class="bi bi-folder2-open"></i></div>
            <span class="fm-step-label">Select Source</span>
        </div>
        <div class="fm-step-connector"></div>
        <div class="fm-step" data-fm-step-indicator="2">
            <div class="fm-step-circle"><i class="bi bi-cursor"></i></div>
            <span class="fm-step-label">Navigate &amp; Select</span>
        </div>
        <div class="fm-step-connector"></div>
        <div class="fm-step" data-fm-step-indicator="3">
            <div class="fm-step-circle"><i class="bi bi-lightning-charge"></i></div>
            <span class="fm-step-label">Choose Operation</span>
        </div>
        <div class="fm-step-connector"></div>
        <div class="fm-step" data-fm-step-indicator="4">
            <div class="fm-step-circle"><i class="bi bi-diagram-3"></i></div>
            <span class="fm-step-label">Execute &amp; Monitor</span>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════
         STEP 1 — Select Source (file tree + details)
         ═══════════════════════════════════════════════════════ -->
    <div class="fm-panel" data-fm-panel="1">
        <div class="fm-panel-inner fm-step1-layout">

            <!-- Left: file tree -->
            <div class="fm-tree-col">
                <div class="fm-tree-header">
                    <i class="bi bi-search"></i>
                    <input class="fm-tree-search" id="fmTreeSearch" type="text" placeholder="Filter folders…" autocomplete="off" />
                </div>
                <div class="fm-tree" id="fmTree">
                    @if (!Model.Dashboard.Locations.Any())
                    {
                        <div class="fm-empty-state text-center py-4 px-3">
                            <i class="bi bi-hdd-network-fill" style="font-size:2.5rem;color:var(--sl-muted);opacity:0.6;"></i>
                            <div class="fw-semibold mt-3 mb-1" style="color:var(--sl-text);">No storage locations configured</div>
                            <div class="small mb-3" style="color:var(--sl-muted);">Add and scan a location first to use the Flow Manager.</div>
                            <a asp-page="/StorageLocations" class="btn btn-primary btn-sm px-3">
                                <i class="bi bi-plus-circle me-1"></i>Add Location
                            </a>
                        </div>
                    }
                    else
                    {
                        @foreach (var loc in Model.Dashboard.Locations)
                        {
                            var locTypeIcon = loc.Type.ToLowerInvariant() switch {
                                "nas" => "bi-hdd-network",
                                "fileshare" => "bi-hdd-stack",
                                _ => "bi-laptop"
                            };
                            var locTypeClass = loc.Type.ToLowerInvariant() switch {
                                "nas" => "fm-tree-icon--drive",
                                "fileshare" => "fm-tree-icon--share",
                                _ => "fm-tree-icon--local"
                            };
                            <div class="fm-tree-group"
                                 data-loc-id="@loc.Id"
                                 data-loc-name="@loc.Name"
                                 data-loc-size="@loc.TotalSizeBytes"
                                 data-loc-files="@loc.FileCount"
                                 data-loc-type="@loc.Type"
                                 data-loc-status="@loc.Status"
                                 data-loc-path="@loc.Path">
                                <div class="fm-tree-drive" data-expand-loc="@loc.Id">
                                    <i class="bi @locTypeIcon @locTypeClass"></i>
                                    <span>@loc.Name</span>
                                    <span class="fm-tree-type-badge">@loc.Type</span>
                                    <i class="bi bi-chevron-down fm-chevron"></i>
                                </div>
                                <div class="fm-tree-children" id="fm-children-@loc.Id" hidden>
                                    <div class="fm-tree-item" data-folder="Documents" data-frac="0.18"><i class="bi bi-file-earmark-text fm-tree-icon--doc"></i><span>Documents</span></div>
                                    <div class="fm-tree-item" data-folder="Images" data-frac="0.22"><i class="bi bi-image fm-tree-icon--img"></i><span>Images</span></div>
                                    <div class="fm-tree-item" data-folder="Videos" data-frac="0.38"><i class="bi bi-camera-video fm-tree-icon--vid"></i><span>Videos</span></div>
                                    <div class="fm-tree-item" data-folder="Archives" data-frac="0.12"><i class="bi bi-archive fm-tree-icon--arc"></i><span>Archives</span></div>
                                    <div class="fm-tree-item" data-folder="System" data-frac="0.10"><i class="bi bi-gear fm-tree-icon--sys"></i><span>System</span></div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- Right: details panel -->
            <div class="fm-details-col" id="fmDetailsCol">
                <div class="fm-details-placeholder">
                    <i class="bi bi-folder2-open fm-details-big-icon"></i>
                    <div>Select a location or folder</div>
                </div>
                <div class="fm-details-content" id="fmDetailsContent" hidden>
                    <div class="fm-details-section">
                        <div class="fm-details-heading">Size</div>
                        <div class="fm-details-value" id="fmDetailSize">—</div>
                        <div class="fm-details-row"><span class="fm-details-lbl">Files</span><span id="fmDetailFiles">—</span></div>
                        <div class="fm-details-row"><span class="fm-details-lbl">Last modified</span><span id="fmDetailDate">—</span></div>
                        <div class="fm-details-row"><span class="fm-details-lbl">Path</span><span id="fmDetailPath" class="fm-details-path">—</span></div>
                    </div>
                    <div class="fm-details-bar-wrap">
                        <div class="fm-details-bar-track"><div class="fm-details-bar-fill" id="fmDetailBar" style="width:0%"></div></div>
                        <div class="fm-details-bar-label" id="fmDetailBarLabel">0% used</div>
                    </div>
                    <div class="fm-details-section">
                        <div class="fm-details-heading">Recent Activity</div>
                        <div class="fm-active-users" id="fmActiveUsers">
                            <div class="fm-user-row text-secondary small"><i class="bi bi-info-circle me-2"></i>Scan history available in Scan Jobs.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="fm-footer">
            <div class="fm-selection-hint" id="fmStep1Hint">Select a location or folder to continue</div>
            <button class="fm-btn fm-btn--ghost" onclick="fmReset()"><i class="bi bi-x-circle"></i> Cancel</button>
            <button class="fm-btn fm-btn--primary" id="fmStep1Next" disabled onclick="fmGoStep(2)">Continue <i class="bi bi-arrow-right"></i></button>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════
         STEP 2 — Navigate & Select Files
         ═══════════════════════════════════════════════════════ -->
    <div class="fm-panel" data-fm-panel="2" hidden>
        <div class="fm-panel-inner">

            <!-- Breadcrumb -->
            <div class="fm-breadcrumb" id="fmBreadcrumb">
                <span class="fm-bc-item fm-bc-item--root" onclick="fmGoStep(1)"><i class="bi bi-house-door"></i> Home</span>
                <i class="bi bi-chevron-right fm-bc-sep"></i>
                <span class="fm-bc-item" id="fmBcLocation">Location</span>
                <i class="bi bi-chevron-right fm-bc-sep"></i>
                <span class="fm-bc-item fm-bc-item--active" id="fmBcFolder">Folder</span>
            </div>

            <!-- Selection toolbar -->
            <div class="fm-select-toolbar">
                <label class="fm-check-all">
                    <input type="checkbox" id="fmSelectAll" onchange="fmToggleAll(this.checked)" />
                    <span>Select all</span>
                </label>
                <div class="fm-select-summary" id="fmSelectSummary">0 items selected</div>
                <div class="fm-select-filters">
                    <button class="fm-filter-btn fm-filter-btn--active" data-ext="all" onclick="fmFilterFiles('all', this)">All</button>
                    <button class="fm-filter-btn" data-ext="video" onclick="fmFilterFiles('video', this)"><i class="bi bi-camera-video"></i> Video</button>
                    <button class="fm-filter-btn" data-ext="image" onclick="fmFilterFiles('image', this)"><i class="bi bi-image"></i> Image</button>
                    <button class="fm-filter-btn" data-ext="archive" onclick="fmFilterFiles('archive', this)"><i class="bi bi-archive"></i> Archive</button>
                    <button class="fm-filter-btn" data-ext="doc" onclick="fmFilterFiles('doc', this)"><i class="bi bi-file-text"></i> Doc</button>
                </div>
            </div>

            <!-- File grid -->
            <div class="fm-file-grid" id="fmFileGrid"></div>

        </div>

        <div class="fm-footer">
            <div class="fm-selection-pill" id="fmSelectionPill">
                <i class="bi bi-check2-square"></i>
                <span id="fmSelPillText">0 files selected</span>
            </div>
            <button class="fm-btn fm-btn--ghost" onclick="fmGoStep(1)"><i class="bi bi-arrow-left"></i> Back</button>
            <button class="fm-btn fm-btn--primary" id="fmStep2Next" disabled onclick="fmGoStep(3)">Choose Operation <i class="bi bi-arrow-right"></i></button>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════
         STEP 3 — Choose Operation & Preview Savings
         ═══════════════════════════════════════════════════════ -->
    <div class="fm-panel" data-fm-panel="3" hidden>
        <div class="fm-panel-inner fm-step3-layout">

            <!-- Main: duplicate/file grid + operation cards -->
            <div class="fm-op-main">
                <div class="fm-step3-tabs">
                    <button class="fm-tab fm-tab--active" onclick="fmSetTab('optimize', this)">Optimizing</button>
                    <button class="fm-tab" onclick="fmSetTab('dedup', this)">Deduplicate Folders</button>
                </div>

                <!-- File icon grid (shows selected files as document cards) -->
                <div class="fm-file-icon-grid" id="fmFileIconGrid"></div>

                <!-- Before vs After gauges -->
                <div class="fm-savings-strip">
                    <div class="fm-savings-panel">
                        <div class="fm-savings-label">Before vs Savings</div>
                        <div class="fm-savings-gauges">
                            <div class="fm-gauge-wrap">
                                <canvas id="fmGaugeBefore" width="110" height="110"></canvas>
                                <div class="fm-gauge-center">
                                    <div class="fm-gauge-val" id="fmGaugeBeforeVal">—</div>
                                    <div class="fm-gauge-sub">Used</div>
                                </div>
                            </div>
                            <div class="fm-savings-arrow">
                                <i class="bi bi-arrow-right"></i>
                            </div>
                            <div class="fm-gauge-wrap">
                                <canvas id="fmGaugeAfter" width="110" height="110"></canvas>
                                <div class="fm-gauge-center">
                                    <div class="fm-gauge-val" id="fmGaugeAfterVal">—</div>
                                    <div class="fm-gauge-sub">After</div>
                                </div>
                            </div>
                        </div>
                        <div class="fm-savings-delta" id="fmSavingsDelta">—</div>
                    </div>
                </div>
            </div>

            <!-- Right: operation action list -->
            <div class="fm-op-sidebar">
                <div class="fm-op-sidebar-title">Operations</div>
                <div class="fm-op-list" id="fmOpList">
                    <div class="fm-op-item fm-op-item--active" data-op="copy" onclick="fmSelectOp('copy', this)">
                        <i class="bi bi-files fm-op-icon fm-op-icon--teal"></i>
                        <div class="fm-op-text">
                            <span class="fm-op-name">Copy Files</span>
                            <span class="fm-op-desc">Duplicate to another location</span>
                        </div>
                    </div>
                    <div class="fm-op-item" data-op="move" onclick="fmSelectOp('move', this)">
                        <i class="bi bi-arrow-left-right fm-op-icon fm-op-icon--blue"></i>
                        <div class="fm-op-text">
                            <span class="fm-op-name">Move Files</span>
                            <span class="fm-op-desc">Relocate to another path</span>
                        </div>
                    </div>
                    <div class="fm-op-item" data-op="archive" onclick="fmSelectOp('archive', this)">
                        <i class="bi bi-snow fm-op-icon fm-op-icon--cyan"></i>
                        <div class="fm-op-text">
                            <span class="fm-op-name">Cold Archive</span>
                            <span class="fm-op-desc">Move to cold storage tier</span>
                        </div>
                    </div>
                    <div class="fm-op-item" data-op="hash" onclick="fmSelectOp('hash', this)">
                        <i class="bi bi-shield-lock fm-op-icon fm-op-icon--purple"></i>
                        <div class="fm-op-text">
                            <span class="fm-op-name">Verify Hash</span>
                            <span class="fm-op-desc">SHA-256 integrity check</span>
                        </div>
                    </div>
                    <div class="fm-op-item" data-op="dedup" onclick="fmSelectOp('dedup', this)">
                        <i class="bi bi-intersect fm-op-icon fm-op-icon--lime"></i>
                        <div class="fm-op-text">
                            <span class="fm-op-name">Deduplicate</span>
                            <span class="fm-op-desc">Remove duplicate copies</span>
                        </div>
                    </div>
                    <div class="fm-op-item" data-op="delete" onclick="fmSelectOp('delete', this)">
                        <i class="bi bi-trash fm-op-icon fm-op-icon--red"></i>
                        <div class="fm-op-text">
                            <span class="fm-op-name">Delete Files</span>
                            <span class="fm-op-desc">Permanently remove files</span>
                        </div>
                    </div>
                    <div class="fm-op-item" data-op="scan" onclick="fmSelectOp('scan', this)">
                        <i class="bi bi-activity fm-op-icon fm-op-icon--orange"></i>
                        <div class="fm-op-text">
                            <span class="fm-op-name">Run Scan Job</span>
                            <span class="fm-op-desc">Full scan &amp; index update</span>
                        </div>
                    </div>
                    <div class="fm-op-item" data-op="report" onclick="fmSelectOp('report', this)">
                        <i class="bi bi-graph-up-arrow fm-op-icon fm-op-icon--teal"></i>
                        <div class="fm-op-text">
                            <span class="fm-op-name">Generate Report</span>
                            <span class="fm-op-desc">Export analytics summary</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="fm-footer">
            <div class="fm-op-selected-label" id="fmOpSelectedLabel"><i class="bi bi-lightning-charge"></i> Copy Files selected</div>
            <button class="fm-btn fm-btn--ghost" onclick="fmGoStep(2)"><i class="bi bi-arrow-left"></i> Back</button>
            <button class="fm-btn fm-btn--primary fm-btn--execute" onclick="fmGoStep(4)">Execute <i class="bi bi-play-fill"></i></button>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════
         STEP 4 — Processing Pipeline Flow Diagram
         ═══════════════════════════════════════════════════════ -->
    <div class="fm-panel" data-fm-panel="4" hidden>
        <div class="fm-panel-inner fm-step4-layout">

            <!-- Pipeline header -->
            <div class="fm-pipeline-header">
                <div>
                    <div class="fm-pipeline-title">Processing Pipeline</div>
                    <div class="fm-pipeline-subtitle" id="fmPipelineSubtitle">Initializing…</div>
                </div>
                <div class="fm-pipeline-controls">
                    <button class="fm-pipe-ctrl-btn" id="fmPipePlayBtn" onclick="fmTogglePipeline()">
                        <i class="bi bi-pause-fill"></i> Pause
                    </button>
                    <button class="fm-pipe-ctrl-btn" onclick="fmRestartPipeline()">
                        <i class="bi bi-arrow-counterclockwise"></i> Restart
                    </button>
                </div>
            </div>

            <!-- Node canvas -->
            <div class="fm-flow-canvas" id="fmFlowCanvas">
                <svg class="fm-flow-svg" id="fmFlowSvg" width="100%" height="100%"></svg>
                <!-- Nodes injected by JS -->
            </div>

            <!-- Log feed -->
            <div class="fm-log-strip">
                <div class="fm-log-header"><i class="bi bi-terminal"></i> Live Log</div>
                <div class="fm-log-feed" id="fmLogFeed"></div>
            </div>

            <!-- ── Cinematic pipeline visualization (frame_005 style) ── -->
            <div class="fm-cinematic-wrap" id="fmCinematicWrap">
                <div class="fm-cinematic-bar">
                    <i class="bi bi-diagram-3"></i>
                    <span>Pipeline Visualization</span>
                    <span class="fm-cin-stage-label" id="fmCinStageLabel">—</span>
                </div>
                <div class="fm-cin-canvas" id="fmCinCanvas">
                    <svg class="fm-cin-svg" id="fmCinSvg" width="100%" height="100%"></svg>
                    <!-- nodes injected by JS -->
                </div>
            </div>

        </div>

        <div class="fm-footer">
            <div class="fm-pipe-status" id="fmPipeStatus">
                <span class="fm-pipe-dot fm-pipe-dot--running"></span>
                <span id="fmPipeStatusText">Running</span>
            </div>
            <button class="fm-btn fm-btn--ghost" onclick="fmGoStep(3)"><i class="bi bi-arrow-left"></i> Back</button>
            <button class="fm-btn fm-btn--primary" onclick="fmReset()"><i class="bi bi-arrow-repeat"></i> New Flow</button>
        </div>
    </div>

</div>

@section Scripts {
<script>
(function () {
'use strict';

// ── Server data ───────────────────────────────────────────────────
const serverLocations = @Html.Raw(locationsJson);
const serverJobs      = @Html.Raw(recentJobsJson);
const serverKpis      = @Html.Raw(kpisJson);
const serverTypeDist  = @Html.Raw(typeDistJson);

// ── Wizard state ─────────────────────────────────────────────────
let currentStep = 1;
let selectedLoc  = null;   // { id, name, size, files, path, type, status }
let selectedFolder = null; // string (folder name)
let selectedFiles  = [];   // array of file objects
let selectedOp     = 'copy';
let pipelineTimer  = null;
let pipelinePaused = false;
let pipelineNodeIdx = 0;
let pipelineNodes   = [];

// ── Formatters ────────────────────────────────────────────────────
const fmt = (bytes) => {
    if (!bytes) return '0 B';
    if (bytes >= 1099511627776) return (bytes / 1099511627776).toFixed(1) + ' TB';
    if (bytes >= 1073741824)    return (bytes / 1073741824).toFixed(1) + ' GB';
    if (bytes >= 1048576)       return (bytes / 1048576).toFixed(1) + ' MB';
    return (bytes / 1024).toFixed(1) + ' KB';
};
const fmtN = (n) => (n || 0).toLocaleString();
const randBetween = (a, b) => Math.floor(Math.random() * (b - a + 1)) + a;

// ── Step navigation ───────────────────────────────────────────────
window.fmGoStep = (step) => {
    if (step === 2 && !selectedLoc) return;
    if (step === 4) fmStartPipeline();

    document.querySelectorAll('[data-fm-panel]').forEach(p => { p.hidden = true; });
    document.querySelector(`[data-fm-panel="${step}"]`).hidden = false;

    document.querySelectorAll('[data-fm-step-indicator]').forEach(el => {
        const n = parseInt(el.dataset.fmStepIndicator);
        el.classList.toggle('fm-step--active', n === step);
        el.classList.toggle('fm-step--done', n < step);
    });

    currentStep = step;
    if (step === 2) fmBuildFileGrid();
    if (step === 3) fmBuildOpPanel();
};

window.fmReset = () => {
    selectedLoc = null; selectedFolder = null;
    selectedFiles = []; selectedOp = 'copy';
    if (pipelineTimer) clearInterval(pipelineTimer);
    fmGoStep(1);
    document.querySelectorAll('.fm-tree-item, .fm-tree-drive').forEach(el => el.classList.remove('fm-tree--selected', 'fm-tree--active'));
    document.getElementById('fmDetailsContent').hidden = true;
    document.getElementById('fmDetailsPlaceholder')?.classList.remove('hidden');
    document.getElementById('fmStep1Next').disabled = true;
    document.getElementById('fmStep1Hint').textContent = 'Select a location or folder to continue';
};

// ── Step 1: Tree ──────────────────────────────────────────────────
document.querySelectorAll('[data-expand-loc]').forEach(driveEl => {
    driveEl.addEventListener('click', () => {
        const locId = driveEl.dataset.expandLoc;
        const children = document.getElementById(`fm-children-${locId}`);
        const chevron = driveEl.querySelector('.fm-chevron');
        const group = driveEl.closest('.fm-tree-group');
        const expanded = !children.hidden;

        children.hidden = expanded;
        if (chevron) chevron.style.transform = expanded ? '' : 'rotate(180deg)';

        // Select the drive itself
        if (!expanded) {
            fmSelectLocation(group);
        }
    });
});

document.querySelectorAll('.fm-tree-item').forEach(item => {
    item.addEventListener('click', (e) => {
        e.stopPropagation();
        const group = item.closest('.fm-tree-group');
        fmSelectLocation(group, item);
    });
});

function fmSelectLocation(group, folderItem) {
    document.querySelectorAll('.fm-tree-item, .fm-tree-drive').forEach(el => el.classList.remove('fm-tree--selected'));

    const ds = group.dataset;
    selectedLoc = {
        id: ds.locId, name: ds.locName,
        size: parseInt(ds.locSize) || 0,
        files: parseInt(ds.locFiles) || 0,
        path: ds.locPath, type: ds.locType, status: ds.locStatus
    };

    if (folderItem) {
        folderItem.classList.add('fm-tree--selected');
        selectedFolder = folderItem.dataset.folder;
        const frac = parseFloat(folderItem.dataset.frac) || 0.3;
        selectedLoc._folderSize = Math.floor(selectedLoc.size * frac);
        selectedLoc._folderFiles = Math.floor(selectedLoc.files * frac);
    } else {
        group.querySelector('.fm-tree-drive').classList.add('fm-tree--selected');
        selectedFolder = null;
        selectedLoc._folderSize = selectedLoc.size;
        selectedLoc._folderFiles = selectedLoc.files;
    }

    fmShowDetails();
    document.getElementById('fmStep1Next').disabled = false;
    document.getElementById('fmStep1Hint').textContent = `Selected: ${selectedLoc.name}${selectedFolder ? ' / ' + selectedFolder : ''}`;
}

function fmShowDetails() {
    const placeholder = document.querySelector('.fm-details-placeholder');
    const content = document.getElementById('fmDetailsContent');
    if (placeholder) placeholder.style.display = 'none';
    content.hidden = false;

    document.getElementById('fmDetailSize').textContent = fmt(selectedLoc._folderSize);
    document.getElementById('fmDetailFiles').textContent = fmtN(selectedLoc._folderFiles);
    document.getElementById('fmDetailPath').textContent = selectedFolder
        ? `${selectedLoc.path}\\${selectedFolder}`
        : selectedLoc.path;

    const now = new Date();
    now.setDate(now.getDate() - randBetween(0, 14));
    document.getElementById('fmDetailDate').textContent = now.toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric' });

    const maxBytes = 20 * 1024 * 1024 * 1024 * 1024; // 20 TB ref
    const pct = Math.min(99, Math.floor((selectedLoc._folderSize / maxBytes) * 100));
    document.getElementById('fmDetailBar').style.width = pct + '%';
    document.getElementById('fmDetailBarLabel').textContent = `${pct}% capacity used`;
}

// Filter search
document.getElementById('fmTreeSearch').addEventListener('input', function () {
    const q = this.value.toLowerCase();
    document.querySelectorAll('.fm-tree-group').forEach(g => {
        const name = g.dataset.locName.toLowerCase();
        g.style.display = (!q || name.includes(q)) ? '' : 'none';
    });
});

// ── Step 2: File Grid ─────────────────────────────────────────────
const mockFileTemplates = {
