function fmBuildFileGrid() {
    const grid = document.getElementById('fmFileGrid');
    grid.innerHTML = '';
    document.getElementById('fmSelectAll').checked = false;

    const key = selectedFolder || 'default';
    const templates = mockFileTemplates[key] || mockFileTemplates.default;
    const files = templates.map(([name, ext, type, size], i) => ({
        id: i, name, ext, type,
        size: Math.floor(size * (0.7 + Math.random() * 0.6)),
        modified: new Date(Date.now() - randBetween(1, 60) * 86400000)
    }));

    files.forEach(f => {
        const card = document.createElement('div');
        card.className = 'fm-file-card';
        card.dataset.fileType = f.type;
        card.dataset.fileId = f.id;
        card.innerHTML = `
            <input class="fm-file-check" type="checkbox" onchange="fmUpdateSelection()" />
            <i class="bi ${fileTypeIcons[f.type] || 'bi-file'}" style="color:${fileTypeColors[f.type]};font-size:1.4rem;margin-bottom:0.3rem;"></i>
            <div class="fm-file-name">${f.name}</div>
            <div class="fm-file-size">${fmt(f.size)}</div>
            <div class="fm-file-date">${f.modified.toLocaleDateString('en-GB',{day:'2-digit',month:'short'})}</div>`;
        card.addEventListener('click', (e) => {
            if (e.target.type === 'checkbox') return;
            card.classList.toggle('fm-file-card--selected');
            card.querySelector('input').checked = card.classList.contains('fm-file-card--selected');
            fmUpdateSelection();
        });
        grid.appendChild(card);
    });

    // Update breadcrumb
    document.getElementById('fmBcLocation').textContent = selectedLoc?.name || 'Location';
    document.getElementById('fmBcFolder').textContent = selectedFolder || 'Root';

    fmUpdateSelection();
}

window.fmUpdateSelection = () => {
    selectedFiles = [];
    document.querySelectorAll('.fm-file-card--selected').forEach(c => {
        const name = c.querySelector('.fm-file-name').textContent;
        const sizeText = c.querySelector('.fm-file-size').textContent;
        selectedFiles.push({ name, type: c.dataset.fileType });
