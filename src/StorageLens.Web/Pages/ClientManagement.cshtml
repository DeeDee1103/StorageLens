@page
@model ClientManagementModel

<section class="mb-3 reveal-item">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-2">
            <li class="breadcrumb-item"><a asp-page="/Settings">Settings</a></li>
            <li class="breadcrumb-item active" aria-current="page">Client Management</li>
        </ol>
    </nav>
    <h1 class="dashboard-title">Client Management</h1>
    <p class="text-secondary mb-0">Add and manage client companies, assign service access, and configure per-client notifications. Owner access only.</p>
</section>

@if (Model.SuccessMessage is not null)
{
    <div class="alert alert-success alert-dismissible fade show reveal-item" role="alert">
        <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>@Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger alert-dismissible fade show reveal-item" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>@Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@* ══════════════════════════════════════════════════════════════════════════
   OWNER LOCK SCREEN
   ══════════════════════════════════════════════════════════════════════════ *@
@if (!Model.IsOwnerAuthenticated)
{
    <div class="row justify-content-center reveal-item">
        <div class="col-md-5 col-lg-4">
            <div class="card-premium p-4 text-center">
                <div class="kpi-icon kpi-icon-orange mx-auto mb-3" style="width:3rem;height:3rem;font-size:1.4rem;">
                    <i class="bi bi-shield-lock-fill" aria-hidden="true"></i>
                </div>
                <h5 class="mb-1">Owner Access Required</h5>
                <p class="text-secondary small mb-4">
                    Client management is restricted to the application owner.
                    Enter the owner PIN to unlock.
                </p>
                <form method="post" asp-page-handler="Unlock">
                    <div class="mb-3 text-start">
                        <label class="form-label" for="OwnerPin">Owner PIN</label>
                        <input class="form-control" id="OwnerPin" name="OwnerPin" type="password"
                               placeholder="Enter owner PIN" autocomplete="current-password" required />
                    </div>
                    <button class="btn btn-gradient w-100" type="submit">
                        <i class="bi bi-unlock me-1" aria-hidden="true"></i>Unlock
                    </button>
                </form>
                <div class="mt-3">
                    <a asp-page="/Settings" class="text-secondary small">
                        <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back to Settings
                    </a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    @* ══════════════════════════════════════════════════════════════════════
       OWNER ADMIN UI
       ══════════════════════════════════════════════════════════════════════ *@

    <!-- Lock button -->
    <div class="d-flex align-items-center gap-2 mb-3 reveal-item flex-wrap">
        <span class="badge bg-success bg-opacity-20 text-success">
            <i class="bi bi-shield-check me-1" aria-hidden="true"></i>Owner Mode Active
        </span>
        <form method="post" asp-page-handler="Lock" class="ms-auto">
            <button type="submit" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-lock me-1" aria-hidden="true"></i>Lock
            </button>
        </form>
    </div>

    <!-- KPI summary -->
    <div class="row g-3 mb-4 reveal-item">
        <div class="col-sm-4">
            <div class="card-premium p-3 text-center">
                <div class="kpi-icon kpi-icon-blue mx-auto mb-2"><i class="bi bi-people-fill" aria-hidden="true"></i></div>
                <div class="fs-3 fw-bold">@Model.TotalClients</div>
                <div class="text-secondary small">Total Clients</div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card-premium p-3 text-center">
                <div class="kpi-icon kpi-icon-green mx-auto mb-2"><i class="bi bi-person-check-fill" aria-hidden="true"></i></div>
                <div class="fs-3 fw-bold">@Model.ActiveClients</div>
                <div class="text-secondary small">Active</div>
            </div>
        </div>
        <div class="col-sm-4">
            <div class="card-premium p-3 text-center">
                <div class="kpi-icon kpi-icon-teal mx-auto mb-2"><i class="bi bi-person-plus-fill" aria-hidden="true"></i></div>
                <div class="fs-3 fw-bold">@Model.NewThisMonth</div>
                <div class="text-secondary small">New This Month</div>
            </div>
        </div>
    </div>

    <!-- Add new client button -->
    <div class="d-flex align-items-center justify-content-between mb-3 reveal-item">
        <h5 class="mb-0"><i class="bi bi-building me-2" aria-hidden="true"></i>Client Accounts</h5>
        <button class="btn btn-gradient btn-sm" type="button"
                data-bs-toggle="modal" data-bs-target="#clientFormModal"
                onclick="resetClientForm()">
            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add New Client
        </button>
    </div>

    <!-- Client table -->
    <div class="card-premium reveal-item">
        @if (!Model.Clients.Any())
        {
            <div class="p-5 text-center text-secondary">
                <i class="bi bi-people fs-1 mb-3 d-block opacity-25" aria-hidden="true"></i>
                <p class="mb-3">No clients yet. Add your first client to get started.</p>
                <button class="btn btn-gradient" type="button"
                        data-bs-toggle="modal" data-bs-target="#clientFormModal"
                        onclick="resetClientForm()">
                    <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add First Client
                </button>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="clientsTable">
                    <thead>
                        <tr>
                            <th>Account #</th>
                            <th>Company</th>
                            <th>Primary Contact</th>
                            <th>Email</th>
                            <th>Tier</th>
                            <th>Status</th>
                            <th>Since</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var client in Model.Clients)
                        {
                            var tierName = Model.AvailableTiers.FirstOrDefault(t => t.Id == client.AssignedTierId)?.Name ?? client.AssignedTierId;
                            <tr>
                                <td><code class="small">@client.AccountNumber</code></td>
                                <td>
                                    <div class="fw-semibold">@client.CompanyName</div>
                                    @if (!string.IsNullOrEmpty(client.Industry))
                                    {
                                        <div class="text-secondary small">@client.Industry</div>
                                    }
                                </td>
                                <td>
                                    @($"{client.ContactFirstName} {client.ContactLastName}".Trim())
                                    @if (!string.IsNullOrEmpty(client.ContactTitle))
                                    {
                                        <div class="text-secondary small">@client.ContactTitle</div>
                                    }
                                </td>
                                <td>
                                    <a href="mailto:@client.ContactEmail" class="text-decoration-none small">@client.ContactEmail</a>
                                    @if (!string.IsNullOrEmpty(client.ContactPhone))
                                    {
                                        <div class="text-secondary small">@client.ContactPhone</div>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(tierName))
                                    {
                                        <span class="badge bg-primary bg-opacity-15 text-primary">@tierName</span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary small">—</span>
                                    }
                                </td>
                                <td>
                                    @{
                                        var (badgeCss, icon) = client.Status switch {
                                            ClientStatus.Active    => ("bg-success bg-opacity-15 text-success", "bi-check-circle-fill"),
                                            ClientStatus.Inactive  => ("bg-secondary bg-opacity-15 text-secondary", "bi-pause-circle-fill"),
                                            ClientStatus.Suspended => ("bg-danger bg-opacity-15 text-danger", "bi-x-circle-fill"),
                                            _                       => ("bg-secondary bg-opacity-15 text-secondary", "bi-question-circle")
                                        };
                                    }
                                    <span class="badge @badgeCss">
                                        <i class="bi @icon me-1" aria-hidden="true"></i>@client.Status
                                    </span>
                                </td>
                                <td class="text-secondary small">@client.CreatedAt.ToString("MMM d, yyyy")</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary me-1"
                                            type="button"
                                            data-bs-toggle="modal"
                                            data-bs-target="#clientFormModal"
                                            onclick="populateClientForm(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
                                                id              = client.Id,
                                                companyName     = client.CompanyName,
                                                industry        = client.Industry,
                                                website         = client.Website,
                                                contactFirst    = client.ContactFirstName,
                                                contactLast     = client.ContactLastName,
                                                contactEmail    = client.ContactEmail,
                                                contactPhone    = client.ContactPhone,
                                                contactTitle    = client.ContactTitle,
                                                billingAddress  = client.BillingAddress,
                                                city            = client.City,
                                                state           = client.State,
                                                postalCode      = client.PostalCode,
                                                country         = client.Country,
                                                tierId          = client.AssignedTierId,
                                                serviceIds      = ClientManagementModel.ParseServiceIds(client.AssignedServiceIdsJson),
                                                notifEmails     = client.NotificationEmails,
                                                notifScanComplete   = client.NotifyOnScanComplete,
                                                notifScanFailed     = client.NotifyOnScanFailed,
                                                notifDuplicates     = client.NotifyOnDuplicatesFound,
                                                notifThreshold      = client.NotifyOnStorageThreshold,
                                                thresholdPct        = client.StorageThresholdPercent,
                                                contractStart   = client.ContractStartDate?.ToString("yyyy-MM-dd") ?? string.Empty,
                                                contractEnd     = client.ContractEndDate?.ToString("yyyy-MM-dd") ?? string.Empty,
                                                status          = client.Status,
                                                notes           = client.Notes
                                            })))">
                                        <i class="bi bi-pencil" aria-hidden="true"></i>
                                    </button>
                                    <form method="post" asp-page-handler="DeleteClient" class="d-inline"
                                          data-company-name="@client.CompanyName"
                                          onsubmit="return confirmClientDelete(this);">
                                        <input type="hidden" name="clientId" value="@client.Id" />
                                        <button class="btn btn-sm btn-outline-danger" type="submit">
                                            <i class="bi bi-trash3" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @* ══════════════════════════════════════════════════════════════════════
       ADD / EDIT CLIENT MODAL
       ══════════════════════════════════════════════════════════════════════ *@
    <div class="modal fade" id="clientFormModal" tabindex="-1" aria-labelledby="clientFormModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <form method="post" asp-page-handler="SaveClient">
                    <div class="modal-header">
                        <h5 class="modal-title" id="clientFormModalLabel">
                            <i class="bi bi-building me-2" aria-hidden="true"></i>
                            <span id="modalTitleText">Add New Client</span>
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="FormClientId" id="FormClientId" />

                        <!-- Company Information -->
                        <h6 class="mb-3 text-primary"><i class="bi bi-building me-2" aria-hidden="true"></i>Company Information</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label" for="FormCompanyName">Company Name <span class="text-danger">*</span></label>
                                <input class="form-control" id="FormCompanyName" name="FormCompanyName" type="text"
                                       placeholder="Acme Corporation" required maxlength="200" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="FormIndustry">Industry</label>
                                <input class="form-control" id="FormIndustry" name="FormIndustry" type="text"
                                       placeholder="Technology" maxlength="100" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="FormWebsite">Website</label>
                                <input class="form-control" id="FormWebsite" name="FormWebsite" type="url"
                                       placeholder="https://example.com" maxlength="300" />
                            </div>
                        </div>

                        <hr class="my-3" />

                        <!-- Primary Contact -->
                        <h6 class="mb-3 text-primary"><i class="bi bi-person me-2" aria-hidden="true"></i>Primary Contact</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-3">
                                <label class="form-label" for="FormContactFirstName">First Name</label>
                                <input class="form-control" id="FormContactFirstName" name="FormContactFirstName"
                                       type="text" placeholder="Jane" maxlength="100" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="FormContactLastName">Last Name</label>
                                <input class="form-control" id="FormContactLastName" name="FormContactLastName"
                                       type="text" placeholder="Smith" maxlength="100" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="FormContactTitle">Title / Role</label>
                                <input class="form-control" id="FormContactTitle" name="FormContactTitle"
                                       type="text" placeholder="IT Director" maxlength="100" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="FormContactPhone">Phone</label>
                                <input class="form-control" id="FormContactPhone" name="FormContactPhone"
                                       type="tel" placeholder="+1 555 000 0000" maxlength="50" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="FormContactEmail">Email <span class="text-danger">*</span></label>
                                <input class="form-control" id="FormContactEmail" name="FormContactEmail"
                                       type="email" placeholder="jane@acme.com" required maxlength="254" />
                            </div>
                        </div>

                        <hr class="my-3" />

                        <!-- Billing Address -->
                        <h6 class="mb-3 text-primary"><i class="bi bi-geo-alt me-2" aria-hidden="true"></i>Billing Address</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-12">
                                <label class="form-label" for="FormBillingAddress">Street Address</label>
                                <input class="form-control" id="FormBillingAddress" name="FormBillingAddress"
                                       type="text" placeholder="123 Main St, Suite 400" maxlength="300" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="FormCity">City</label>
                                <input class="form-control" id="FormCity" name="FormCity"
                                       type="text" placeholder="New York" maxlength="100" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label" for="FormState">State / Province</label>
                                <input class="form-control" id="FormState" name="FormState"
                                       type="text" placeholder="NY" maxlength="100" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label" for="FormPostalCode">Postal Code</label>
                                <input class="form-control" id="FormPostalCode" name="FormPostalCode"
                                       type="text" placeholder="10001" maxlength="20" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="FormCountry">Country</label>
                                <input class="form-control" id="FormCountry" name="FormCountry"
                                       type="text" placeholder="United States" maxlength="100" />
                            </div>
                        </div>

                        <hr class="my-3" />

                        <!-- Service Access -->
                        <h6 class="mb-3 text-primary"><i class="bi bi-grid me-2" aria-hidden="true"></i>Service Access</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label class="form-label" for="FormAssignedTierId">Subscription Tier</label>
                                <select class="form-select" id="FormAssignedTierId" name="FormAssignedTierId">
                                    <option value="">— No tier assigned —</option>
                                    @foreach (var tier in Model.AvailableTiers)
                                    {
                                        <option value="@tier.Id">@tier.Name</option>
                                    }
                                </select>
                                <div class="form-text">Tier defaults determine which services are included.</div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="FormContractStartDate">Contract Start</label>
                                <input class="form-control" id="FormContractStartDate" name="FormContractStartDate"
                                       type="date" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="FormContractEndDate">Contract End</label>
                                <input class="form-control" id="FormContractEndDate" name="FormContractEndDate"
                                       type="date" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Additional Services Granted</label>
                                <div class="row g-2">
                                    @foreach (var svc in Model.AvailableServices)
                                    {
                                        <div class="col-md-4">
                                            <div class="form-check">
                                                <input class="form-check-input service-checkbox"
                                                       type="checkbox"
                                                       name="FormAssignedServiceIds"
                                                       value="@svc.Id"
                                                       id="svc_@svc.Id" />
                                                <label class="form-check-label small" for="svc_@svc.Id">
                                                    <i class="bi @svc.Icon me-1" aria-hidden="true"></i>@svc.Name
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <div class="form-text">Check services to grant in addition to tier defaults.</div>
                            </div>
                        </div>

                        <hr class="my-3" />

                        <!-- Notification Settings -->
                        <h6 class="mb-3 text-primary"><i class="bi bi-bell me-2" aria-hidden="true"></i>Notification Settings</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-12">
                                <label class="form-label" for="FormNotificationEmails">Notification Email Addresses</label>
                                <input class="form-control" id="FormNotificationEmails" name="FormNotificationEmails"
                                       type="text" placeholder="notify@acme.com, ops@acme.com"
                                       maxlength="1000" />
                                <div class="form-text">Comma-separated list of email addresses to notify for this client's events.</div>
                            </div>
                            <div class="col-12">
                                <label class="form-label d-block">Alert Triggers</label>
                                <div class="d-flex flex-wrap gap-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="FormNotifyOnScanComplete"
                                               name="FormNotifyOnScanComplete" value="true" />
                                        <label class="form-check-label small" for="FormNotifyOnScanComplete">Scan completed</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="FormNotifyOnScanFailed"
                                               name="FormNotifyOnScanFailed" value="true" />
                                        <label class="form-check-label small" for="FormNotifyOnScanFailed">Scan failed</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="FormNotifyOnDuplicatesFound"
                                               name="FormNotifyOnDuplicatesFound" value="true" />
                                        <label class="form-check-label small" for="FormNotifyOnDuplicatesFound">Duplicates detected</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="FormNotifyOnStorageThreshold"
                                               name="FormNotifyOnStorageThreshold" value="true" />
                                        <label class="form-check-label small" for="FormNotifyOnStorageThreshold">Storage threshold exceeded</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label" for="FormStorageThresholdPercent">Threshold %</label>
                                <div class="input-group">
                                    <input class="form-control" id="FormStorageThresholdPercent"
                                           name="FormStorageThresholdPercent" type="number"
                                           min="1" max="100" value="90" />
                                    <span class="input-group-text">%</span>
                                </div>
                            </div>
                        </div>

                        <hr class="my-3" />

                        <!-- Status & Notes -->
                        <h6 class="mb-3 text-primary"><i class="bi bi-info-circle me-2" aria-hidden="true"></i>Account Status &amp; Notes</h6>
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label" for="FormStatus">Account Status</label>
                                <select class="form-select" id="FormStatus" name="FormStatus">
                                    @foreach (var s in ClientStatus.All)
                                    {
                                        <option value="@s">@s</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="FormNotes">Notes</label>
                                <textarea class="form-control" id="FormNotes" name="FormNotes"
                                          rows="3" maxlength="2000"
                                          placeholder="Internal notes about this client..."></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-gradient">
                            <i class="bi bi-floppy me-1" aria-hidden="true"></i>Save Client
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
    function resetClientForm() {
        document.getElementById('FormClientId').value = '';
        document.getElementById('modalTitleText').textContent = 'Add New Client';
        document.querySelector('#clientFormModal form').reset();
        document.getElementById('FormStorageThresholdPercent').value = 90;
    }

    function populateClientForm(data) {
        document.getElementById('FormClientId').value = data.id;
        document.getElementById('modalTitleText').textContent = 'Edit Client: ' + data.companyName;

        var f = document.querySelector('#clientFormModal form');
        f.reset();

        setVal('FormCompanyName', data.companyName);
        setVal('FormIndustry', data.industry);
        setVal('FormWebsite', data.website);
        setVal('FormContactFirstName', data.contactFirst);
        setVal('FormContactLastName', data.contactLast);
        setVal('FormContactEmail', data.contactEmail);
        setVal('FormContactPhone', data.contactPhone);
        setVal('FormContactTitle', data.contactTitle);
        setVal('FormBillingAddress', data.billingAddress);
        setVal('FormCity', data.city);
        setVal('FormState', data.state);
        setVal('FormPostalCode', data.postalCode);
        setVal('FormCountry', data.country);
        setVal('FormAssignedTierId', data.tierId);
        setVal('FormNotificationEmails', data.notifEmails);
        setVal('FormContractStartDate', data.contractStart);
        setVal('FormContractEndDate', data.contractEnd);
        setVal('FormStatus', data.status);
        setVal('FormNotes', data.notes);

        setChk('FormNotifyOnScanComplete', data.notifScanComplete);
        setChk('FormNotifyOnScanFailed', data.notifScanFailed);
        setChk('FormNotifyOnDuplicatesFound', data.notifDuplicates);
        setChk('FormNotifyOnStorageThreshold', data.notifThreshold);
        setVal('FormStorageThresholdPercent', data.thresholdPct);

        // Service checkboxes
        document.querySelectorAll('.service-checkbox').forEach(function(cb) {
            cb.checked = data.serviceIds && data.serviceIds.includes(cb.value);
        });
    }

    function setVal(id, val) {
        var el = document.getElementById(id);
        if (el) el.value = val ?? '';
    }

    function setChk(id, val) {
        var el = document.getElementById(id);
        if (el) el.checked = !!val;
    }

    function confirmClientDelete(form) {
        var name = form.getAttribute('data-company-name') || 'this client';
        return confirm('Delete client "' + name + '"? This cannot be undone.');
    }
</script>
}
