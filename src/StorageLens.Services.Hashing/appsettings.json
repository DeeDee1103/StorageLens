{
  "ConnectionStrings": {
    "HashingDb": "Server=(localdb)\\MSSQLLocalDB;Database=StorageLensMvp;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "UpstreamServices": {
    "FileInventory": "http://localhost:5103/",
    "ScanJobs": "http://localhost:5102/"
  },
  "UpstreamResilience": {
    "MaxRetryAttempts": 3,
    "TimeoutSeconds": 30,
    "BaseDelaySeconds": 1,
    "MaxDelaySeconds": 8,
    "CircuitBreakerFailures": 5,
    "CircuitBreakerBreakSeconds": 30,
    "ClientOverrides": {
      "scanjobs": {
        "CircuitBreakerFailures": 3,
        "CircuitBreakerBreakSeconds": 20
      }
    }
  },
  "HashingWorker": {
    "MaxDegreeOfParallelism": 4,
    "BatchSize": 500,
    "MaxFileSizeBytes": 2147483648
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
