{
  "ConnectionStrings": {
    "ScannerDb": "Server=(localdb)\\MSSQLLocalDB;Database=StorageLensMvp;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "UpstreamServices": {
    "FileInventory": "http://localhost:5103/",
    "ScanJobs": "http://localhost:5102/"
  },
  "ScannerPathMappings": {
    "EnableAutoMapping": true,
    "AutoMapInContainerOnly": true,
    "Mappings": [
      {
        "Mode": "Prefix",
        "Pattern": "C:\\",
        "Replacement": "/host/drives/c",
        "Enabled": false,
        "Description": "Example prefix mapping for drive C when using /host/drives/c mount."
      },
      {
        "Mode": "Regex",
        "Pattern": "^\\\\\\\\([^\\\\]+)\\\\([^\\\\]+)(.*)$",
        "Replacement": "/host/unc/$1/$2$3",
        "Enabled": false,
        "Description": "Example UNC regex mapping. Auto UNC mapping is built in and usually does not require this rule."
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
