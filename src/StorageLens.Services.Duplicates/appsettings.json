{
  "UpstreamServices": {
    "FileInventory": "http://localhost:5103/"
  },
  "UpstreamResilience": {
    "MaxRetryAttempts": 3,
    "TimeoutSeconds": 30,
    "BaseDelaySeconds": 1,
    "MaxDelaySeconds": 8,
    "CircuitBreakerFailures": 5,
    "CircuitBreakerBreakSeconds": 30
  },
  "ConnectionStrings": {
    "DuplicatesDb": "Server=(localdb)\\MSSQLLocalDB;Database=StorageLensMvp;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
