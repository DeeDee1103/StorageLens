    "ClientOverrides": {
      "scanner": {
        "MaxRetryAttempts": 1,
        "TimeoutSeconds": 14400,
        "CircuitBreakerFailures": 3,
        "CircuitBreakerBreakSeconds": 20
      },
      "hashing": {
        "MaxRetryAttempts": 1,
        "TimeoutSeconds": 14400,
        "CircuitBreakerFailures": 3,
        "CircuitBreakerBreakSeconds": 20
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
